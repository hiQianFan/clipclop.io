---
import { site, type Locale } from "../i18n";
import { Icon } from "astro-icon/components";
interface Props { locale: Locale; current?: "home" | "download" | "changelog" | "privacy"; }
const { locale, current = "home" } = Astro.props;
const home = `/${locale}`;
const nav = site[locale].nav;
const route = (page) => `${home}/${page}`;
const suffix = Astro.url.pathname.replace(/^\/(zh|en)/, "").replace(/\/$/, "");
const localeRoute = (next) => `/${next}${suffix}${Astro.url.search}`;
---
<header class="global-header"><div class="header-left"><a class="global-brand" href={home}><img src="/favicon.png" alt=""><span>ClipClop</span></a><a class="github-star" href="https://github.com/hiQianFan/ClipClop" target="_blank" rel="noopener noreferrer" aria-label="Star ClipClop on GitHub"><Icon name="simple-icons:github"/><b data-star-count></b><Icon name="lucide:star" class="star-accent" stroke-width="1.5" is:inline/></a></div><nav class="global-nav" aria-label={nav.primary}><a href={route("download")} aria-current={current === "download" ? "page" : undefined}><Icon name="lucide:download"/><span data-nav="download">{nav.download}</span></a><a href={route("changelog")} aria-current={current === "changelog" ? "page" : undefined}><Icon name="lucide:package-open"/><span data-nav="changelog">{nav.changelog}</span></a><a href={route("privacy")} aria-current={current === "privacy" ? "page" : undefined}><Icon name="lucide:shield-check"/><span data-nav="privacy">{nav.privacy}</span></a><button class="locale-trigger" type="button" popovertarget="locale-menu" aria-label={nav.language}><Icon name="lucide:languages"/><span class="locale-label">{nav.currentLanguage}</span><Icon name="lucide:chevron-down" class="chevron"/></button><button class="theme-trigger" type="button" popovertarget="color-menu" aria-label={nav.theme}><Icon name="lucide:monitor" class="theme-icon system"/><Icon name="lucide:sun" class="theme-icon light"/><Icon name="lucide:moon" class="theme-icon dark"/></button><button class="more-trigger" type="button" popovertarget="more-menu" aria-label={nav.more}><Icon name="lucide:menu" stroke-width="2.4"/></button></nav></header>
<div class="global-menu locale-menu" id="locale-menu" popover><a href={localeRoute("zh")} data-locale="zh"><span>简体中文</span><Icon name="lucide:check" class="check"/></a><a href={localeRoute("en")} data-locale="en"><span>English</span><Icon name="lucide:check" class="check"/></a></div>
<div class="global-menu color-menu" id="color-menu" popover><button type="button" data-theme="system"><Icon name="lucide:monitor"/><span data-theme-label="system">{nav.system}</span><Icon name="lucide:check" class="check"/></button><button type="button" data-theme="light"><Icon name="lucide:sun"/><span data-theme-label="light">{nav.light}</span><Icon name="lucide:check" class="check"/></button><button type="button" data-theme="dark"><Icon name="lucide:moon"/><span data-theme-label="dark">{nav.dark}</span><Icon name="lucide:check" class="check"/></button></div>
<div class="global-menu more-menu" id="more-menu" popover><div class="mobile-menu-head"><a class="global-brand" href={home}><img src="/favicon.png" alt=""><span>ClipClop</span></a><a class="github-star" href="https://github.com/hiQianFan/ClipClop" target="_blank" rel="noopener noreferrer" aria-label="Star ClipClop on GitHub"><Icon name="simple-icons:github"/><b data-star-count></b><Icon name="lucide:star" class="star-accent" stroke-width="1.5" is:inline/></a><button class="menu-close" type="button" popovertarget="more-menu" popovertargetaction="hide" aria-label={nav.close}><Icon name="lucide:menu" class="menu-close-from" stroke-width="2.4"/><Icon name="lucide:x" class="menu-close-to" stroke-width="2"/></button></div><nav class="mobile-destinations" aria-label={nav.mobile}><a href={route("download")} aria-current={current === "download" ? "page" : undefined}><Icon name="lucide:download"/><span data-mobile-nav="download">{nav.download}</span></a><a href={route("changelog")} aria-current={current === "changelog" ? "page" : undefined}><Icon name="lucide:package-open"/><span data-mobile-nav="changelog">{nav.changelog}</span></a><a href={route("privacy")} aria-current={current === "privacy" ? "page" : undefined}><Icon name="lucide:shield-check"/><span data-mobile-nav="privacy">{nav.privacy}</span></a></nav><div class="mobile-settings"><details><summary><Icon name="lucide:languages"/><span data-mobile-label="language">{nav.languageLabel}</span><Icon name="lucide:chevron-down"/></summary><div class="mobile-options"><a href={localeRoute("zh")} data-locale="zh"><span>简体中文</span><Icon name="lucide:check" class="check"/></a><a href={localeRoute("en")} data-locale="en"><span>English</span><Icon name="lucide:check" class="check"/></a></div></details><details><summary><Icon name="lucide:monitor"/><span data-mobile-label="appearance">{nav.appearance}</span><Icon name="lucide:chevron-down"/></summary><div class="mobile-options"><button type="button" data-theme="system"><Icon name="lucide:monitor"/><span data-theme-label="system">{nav.system}</span><Icon name="lucide:check" class="check"/></button><button type="button" data-theme="light"><Icon name="lucide:sun"/><span data-theme-label="light">{nav.light}</span><Icon name="lucide:check" class="check"/></button><button type="button" data-theme="dark"><Icon name="lucide:moon"/><span data-theme-label="dark">{nav.dark}</span><Icon name="lucide:check" class="check"/></button></div></details></div></div>
<style>
  .global-header{width:min(var(--site-max-width,1440px),calc(100vw - 2 * var(--site-gutter,24px)));height:52px;position:fixed;z-index:10;inset:12px 0 auto;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:0 7px 0 10px;border-radius:14px;background:var(--bg-raised);box-shadow:var(--panel-shadow)}.global-header svg,.global-header img,.global-menu svg{pointer-events:none}.global-brand{height:38px;display:flex;align-items:center;gap:8px;padding:0 8px;border-radius:8px;color:var(--text-1);font-weight:650;text-decoration:none}.global-brand:hover,.global-nav a:hover,.global-nav button:hover{background:var(--bg-hover)}.global-brand img{width:25px;height:25px;border-radius:6px}.global-nav{height:100%;display:flex;align-items:center;gap:2px}.global-nav a,.global-nav>button{height:38px;display:flex;align-items:center;justify-content:center;gap:7px;padding:0 11px;border:0;border-radius:8px;color:var(--text-2);background:transparent;font-size:13px;text-decoration:none;white-space:nowrap;transition:color var(--dur-fast) var(--ease-out),background var(--dur-fast) var(--ease-out)}.global-nav a:nth-child(1){width:104px}.global-nav a:nth-child(2){width:126px}.global-nav a:nth-child(3){width:100px}.global-nav a[aria-current]{color:var(--text-1);background:var(--bg-selected)}.global-nav a:hover,.global-nav>button:hover{color:var(--text-1)}.global-nav svg,.global-menu svg{width:15px;height:15px;flex:none}.locale-trigger{width:112px;position:relative;margin-left:5px;font:11px var(--mono)}.locale-trigger:before{width:1px;height:20px;position:absolute;left:-3px;background:var(--hairline);content:"";pointer-events:none}.locale-trigger .chevron{width:12px}.theme-trigger{width:38px;padding:0!important}.theme-icon{display:none}:root:not([data-theme]) .theme-icon.system,:root[data-theme=light] .theme-icon.light,:root[data-theme=dark] .theme-icon.dark{display:block}.global-menu{width:168px;inset:auto;margin:0;padding:5px;border:0;border-radius:8px;color:var(--text-1);background:var(--bg-raised);box-shadow:var(--panel-shadow)}.global-menu::backdrop{background:transparent}.global-menu button{width:100%;height:38px;display:flex;align-items:center;gap:9px;padding:0 10px;border:0;border-radius:6px;color:var(--text-2);background:transparent;font-size:13px;text-align:left;cursor:pointer}.global-menu button:hover{color:var(--text-1);background:var(--bg-hover)}.global-menu button span{flex:1}.global-menu .check{opacity:0}.global-menu button[aria-checked=true]{color:var(--text-1)}.global-menu button[aria-checked=true] .check{opacity:1}@media(max-width:768px){.global-header{width:calc(100vw - 20px)}}@media(max-width:600px){.global-header{height:54px;inset-block-start:8px;padding-inline:6px}.global-brand{padding-inline:6px}.global-brand span,.global-nav a span,.locale-trigger span,.locale-trigger .chevron{display:none}.global-nav a,.global-nav>button{width:44px!important;height:44px;padding:0}.locale-trigger{margin-left:0}.locale-trigger:before{display:none}}
  .header-left{display:flex;align-items:center;gap:8px}.github-star{height:38px;display:flex;align-items:center;gap:6px;padding:0 8px;border-radius:var(--radius-md);color:var(--text-2);font:11px var(--mono);text-decoration:none;transition:color var(--dur-fast) var(--ease-out),background var(--dur-fast) var(--ease-out)}.github-star:hover,.github-star:focus-visible,.github-star:active{color:var(--text-1);background:var(--bg-hover)}.github-star>svg:first-child{width:16px;height:16px}.github-star .star-accent{width:17px;height:17px;color:#f5c518;stroke:#f5c518}:global(.github-star .star-accent path){fill:#f5c518}.github-star b{min-width:2ch;font:inherit;font-variant-numeric:tabular-nums;text-align:right}
</style>
<style>
  .more-trigger,.more-menu{display:none!important}.more-menu:popover-open{display:block!important}.mobile-menu-head,.mobile-settings{display:none}.mobile-destinations a{width:100%;height:38px;display:flex;align-items:center;gap:9px;padding:0 10px;border-radius:var(--radius-md);color:var(--text-2);text-decoration:none;font:600 var(--fs-ui)/var(--lh-snug) var(--sans)}.mobile-destinations a:hover,.mobile-destinations a[aria-current]{color:var(--text-1);background:var(--bg-hover)}
  @media(max-width:600px){.header-left{display:contents}.global-brand{margin-right:auto}.header-left .github-star{display:flex}.global-brand span{display:inline}.global-nav>a:not(.more-trigger),.global-nav>.locale-trigger,.global-nav>.theme-trigger{display:none!important}.global-nav>.more-trigger{width:44px!important;height:44px;display:flex!important}.more-menu{width:100%;height:100dvh;max-width:none;max-height:none;position:fixed;inset:0;margin:0;padding:max(8px,env(safe-area-inset-top)) 10px max(20px,env(safe-area-inset-bottom));border-radius:0;background:var(--bg-shell);overflow:auto}.mobile-menu-head{height:54px;display:flex;align-items:center;padding:0 6px;border:0;border-radius:14px;background:var(--bg-raised);box-shadow:var(--panel-shadow)}.mobile-menu-head .global-brand{padding-inline:6px}.mobile-menu-head .github-star{margin-left:auto}.menu-close{width:44px!important;height:44px!important;margin-left:2px;padding:0!important;display:grid!important;place-items:center;border:0;border-radius:8px;color:var(--text-1)!important;background:transparent!important}.menu-close:hover{background:var(--bg-hover)!important}.menu-close svg{width:22px;height:22px}.mobile-destinations,.mobile-settings{margin-inline:10px}.mobile-destinations{display:flex;flex-direction:column;padding:18px 0 12px;border-bottom:1px solid var(--hairline)}.mobile-destinations a{height:48px;padding:0 8px;font-size:16px}.mobile-destinations svg,.mobile-settings summary>svg:first-child{width:19px;height:19px}.mobile-settings{display:block;padding-top:6px}.mobile-settings details{border-bottom:1px solid var(--hairline)}.mobile-settings summary{height:48px;display:flex;align-items:center;gap:12px;padding:0 8px;color:var(--text-2);font-size:16px;cursor:pointer;list-style:none}.mobile-settings summary::-webkit-details-marker{display:none}.mobile-settings summary span{flex:1}.mobile-settings summary svg:last-child{transition:transform var(--dur-fast) var(--ease-out)}.mobile-settings details[open] summary{color:var(--text-1)}.mobile-settings details[open] summary svg:last-child{transform:rotate(180deg)}.mobile-options{padding:0 0 8px 28px}.mobile-options button{height:42px;font-size:14px}}
</style>
<style>
  .github-star{flex:none}
  @media(max-width:600px){.more-menu{opacity:0;transition:opacity var(--dur-mid,160ms) var(--ease-out),display var(--dur-mid,160ms) allow-discrete,overlay var(--dur-mid,160ms) allow-discrete}.more-menu:popover-open{opacity:1}.mobile-destinations,.mobile-settings{opacity:0;transform:translateY(-10px);transition:opacity var(--dur-mid,160ms) var(--ease-out),transform var(--dur-mid,160ms) var(--ease-out)}.more-menu:popover-open .mobile-destinations,.more-menu:popover-open .mobile-settings{opacity:1;transform:none;transition-delay:40ms}.menu-close{position:relative}.menu-close svg{position:absolute;transition:opacity var(--dur-fast,140ms) var(--ease-out),transform var(--dur-fast,140ms) var(--ease-out)}.menu-close-from{opacity:1;transform:none}.menu-close-to{opacity:0;transform:rotate(-45deg) scale(.72)}.more-menu:popover-open .menu-close-from{opacity:0;transform:rotate(45deg) scale(.72)}.more-menu:popover-open .menu-close-to{opacity:1;transform:none}@starting-style{.more-menu:popover-open{opacity:0}.more-menu:popover-open .mobile-destinations,.more-menu:popover-open .mobile-settings{opacity:0;transform:translateY(-10px)}.more-menu:popover-open .menu-close-from{opacity:1;transform:none}.more-menu:popover-open .menu-close-to{opacity:0;transform:rotate(-45deg) scale(.72)}}}
  @media(max-width:600px){.github-star{height:44px}.global-nav>.more-trigger svg,.menu-close svg{width:20px!important;height:20px!important}.menu-close{margin-left:0!important}}
  @media(prefers-reduced-motion:reduce){.more-menu,.mobile-destinations,.mobile-settings,.menu-close svg,.mobile-settings summary svg:last-child{transition:none!important}}
</style>
<style>
  .locale-menu a,.mobile-options a{width:100%;height:38px;display:flex;align-items:center;gap:9px;padding:0 10px;border-radius:6px;color:var(--text-2);font-size:13px;text-decoration:none}
  .locale-menu a:hover,.mobile-options a:hover{color:var(--text-1);background:var(--bg-hover)}
  .locale-menu a span,.mobile-options a span{flex:1}.locale-menu a .check{opacity:0}.locale-menu a[aria-current] .check{opacity:1}
</style>
<script>
  const header=document.querySelector(".global-header"),localeMenu=document.querySelector("#locale-menu"),colorMenu=document.querySelector("#color-menu"),localeTrigger=document.querySelector(".locale-trigger"),themeTrigger=document.querySelector(".theme-trigger");
  let locale=location.pathname.startsWith("/zh")?"zh":"en";
  function place(menu,trigger){const h=header.getBoundingClientRect(),w=168;if(matchMedia("(max-width:600px)").matches){menu.style.left=`${innerWidth-w-10}px`;menu.style.top=`${h.bottom+8}px`;return}const b=trigger.getBoundingClientRect();menu.style.left=`${Math.max(h.left,Math.min(b.left+b.width/2-w/2,h.right-w))}px`;menu.style.top=`${h.bottom+8}px`}
  function render(){document.querySelectorAll("a[data-locale]").forEach(link=>link.dataset.locale===locale?link.setAttribute("aria-current","true"):link.removeAttribute("aria-current"));const theme=document.documentElement.dataset.theme||"system";document.querySelectorAll("button[data-theme]").forEach(button=>button.setAttribute("aria-checked",String(button.dataset.theme===theme)))}
  document.querySelectorAll("a[data-locale]").forEach(link=>link.addEventListener("click",()=>{try{localStorage.setItem("clipclop-locale",link.dataset.locale)}catch{}if(location.hash)link.hash=location.hash}));document.querySelectorAll("button[data-theme]").forEach(button=>button.addEventListener("click",()=>{const theme=button.dataset.theme;theme==="system"?document.documentElement.removeAttribute("data-theme"):document.documentElement.dataset.theme=theme;try{theme==="system"?localStorage.removeItem("clipclop-theme"):localStorage.setItem("clipclop-theme",theme)}catch{}render();colorMenu.hidePopover();window.dispatchEvent(new Event("clipclop:theme"))}));localeMenu.addEventListener("beforetoggle",event=>{if(event.newState==="open")place(localeMenu,localeTrigger)});colorMenu.addEventListener("beforetoggle",event=>{if(event.newState==="open")place(colorMenu,themeTrigger)});render();const starKey="clipclop-github-stars",starMaxAge=216e5,showStars=count=>document.querySelectorAll("[data-star-count]").forEach(node=>node.textContent=Number(count).toLocaleString());let starCache;try{starCache=JSON.parse(localStorage.getItem(starKey))}catch{}if(Number.isFinite(starCache?.count))showStars(starCache.count);if(!starCache||Date.now()-starCache.cachedAt>starMaxAge)fetch("https://api.github.com/repos/hiQianFan/ClipClop").then(response=>response.ok?response.json():Promise.reject()).then(data=>{showStars(data.stargazers_count);try{localStorage.setItem(starKey,JSON.stringify({count:data.stargazers_count,cachedAt:Date.now()}))}catch{}}).catch(()=>{});
</script>
