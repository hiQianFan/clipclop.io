---
import { Check, ChevronDown, House, Languages, Monitor, Moon, PackageOpen, PanelsTopLeft, Sun } from "@lucide/astro";
const { current = "home" } = Astro.props;
---
<header class="global-header"><a class="global-brand" href="/#home"><img src="/app-icon.png" alt=""><span>ClipClop</span></a><nav class="global-nav" aria-label="Primary navigation"><a href="/#home" aria-current={current === "home" ? "page" : undefined}><House/><span data-nav="home">首页</span></a><a href="/#showcase"><PanelsTopLeft/><span data-nav="demo">产品演示</span></a><a href="/#changelog"><PackageOpen/><span data-nav="changelog">更新日志</span></a><a class="github-star" href="https://github.com/hiQianFan/ClipClop" target="_blank" rel="noopener noreferrer" aria-label="Star ClipClop on GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.84a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg><span>Star</span><b id="global-stars">—</b></a><button class="locale-trigger" type="button" popovertarget="locale-menu"><Languages/><span class="locale-label">简体中文</span><ChevronDown class="chevron"/></button><button class="theme-trigger" type="button" popovertarget="color-menu"><Monitor class="theme-icon system"/><Sun class="theme-icon light"/><Moon class="theme-icon dark"/></button></nav></header>
<div class="global-menu locale-menu" id="locale-menu" popover><button type="button" data-locale="zh"><span>简体中文</span><Check class="check"/></button><button type="button" data-locale="en"><span>English</span><Check class="check"/></button></div>
<div class="global-menu color-menu" id="color-menu" popover><button type="button" data-theme="system"><Monitor/><span data-theme-label="system">跟随系统</span><Check class="check"/></button><button type="button" data-theme="light"><Sun/><span data-theme-label="light">浅色</span><Check class="check"/></button><button type="button" data-theme="dark"><Moon/><span data-theme-label="dark">深色</span><Check class="check"/></button></div>
<style>
  .global-header{width:min(var(--site-max-width,1440px),calc(100vw - 2 * var(--site-gutter,24px)));height:52px;position:fixed;z-index:10;inset:12px 0 auto;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:0 7px 0 10px;border-radius:14px;background:var(--bg-raised);box-shadow:var(--panel-shadow)}.global-brand{height:38px;display:flex;align-items:center;gap:8px;padding:0 8px;border-radius:8px;color:var(--text-1);font-weight:650;text-decoration:none}.global-brand:hover,.global-nav a:hover,.global-nav button:hover{background:var(--bg-hover)}.global-brand img{width:25px;height:25px;border-radius:6px}.global-nav{height:100%;display:flex;align-items:center;gap:2px}.global-nav a,.global-nav>button{height:38px;display:flex;align-items:center;justify-content:center;gap:7px;padding:0 11px;border:0;border-radius:8px;color:var(--text-2);background:transparent;font-size:13px;text-decoration:none;white-space:nowrap;transition:color var(--dur-fast) var(--ease-out),background var(--dur-fast) var(--ease-out),transform var(--dur-fast) var(--ease-out)}.global-nav a:nth-child(1){width:78px}.global-nav a:nth-child(2){width:104px}.global-nav a:nth-child(3){width:112px}.global-nav a[aria-current=page]{color:var(--text-1);background:var(--bg-selected)}.global-nav a:hover,.global-nav>button:hover{color:var(--text-1);transform:translateY(-1px)}.global-nav svg,.global-menu svg{width:15px;height:15px;flex:none}.locale-trigger{width:112px;position:relative;margin-left:5px;font:11px var(--mono)}.locale-trigger:before{width:1px;height:20px;position:absolute;left:-3px;background:var(--hairline);content:""}.locale-trigger .chevron{width:12px}.theme-trigger{width:38px;padding:0!important}.theme-icon{display:none}:root:not([data-theme]) .theme-icon.system,:root[data-theme=light] .theme-icon.light,:root[data-theme=dark] .theme-icon.dark{display:block}.global-menu{width:168px;inset:auto;margin:0;padding:5px;border:0;border-radius:8px;color:var(--text-1);background:var(--bg-raised);box-shadow:var(--panel-shadow)}.global-menu::backdrop{background:transparent}.global-menu button{width:100%;height:38px;display:flex;align-items:center;gap:9px;padding:0 10px;border:0;border-radius:6px;color:var(--text-2);background:transparent;font-size:13px;text-align:left;cursor:pointer}.global-menu button:hover{color:var(--text-1);background:var(--bg-hover)}.global-menu button span{flex:1}.global-menu .check{opacity:0}.global-menu button[aria-checked=true]{color:var(--text-1)}.global-menu button[aria-checked=true] .check{opacity:1}@media(max-width:600px){.global-header{width:calc(100vw - 20px);height:54px;inset-block-start:8px;padding-inline:6px}.global-brand{padding-inline:6px}.global-brand span,.global-nav a:first-child,.global-nav a span,.locale-trigger span,.locale-trigger .chevron{display:none}.global-nav a,.global-nav>button{width:44px!important;height:44px;padding:0}.locale-trigger{margin-left:0}.locale-trigger:before{display:none}}
  .global-nav .github-star{width:96px;gap:6px;font:11px var(--mono)}.github-star b{min-width:18px;font:inherit;text-align:left}@media(max-width:600px){.global-nav .github-star{display:none}}
</style>
<script>
  const header=document.querySelector(".global-header"),localeMenu=document.querySelector("#locale-menu"),colorMenu=document.querySelector("#color-menu"),localeTrigger=document.querySelector(".locale-trigger"),themeTrigger=document.querySelector(".theme-trigger"),localeLabel=document.querySelector(".locale-label"),labels={zh:{home:"首页",demo:"产品演示",changelog:"更新日志",system:"跟随系统",light:"浅色",dark:"深色",language:"选择语言",theme:"选择颜色模式"},en:{home:"Home",demo:"Demo",changelog:"Changelog",system:"System",light:"Light",dark:"Dark",language:"Choose language",theme:"Choose color mode"}};
  let saved;try{saved=localStorage.getItem("clipclop-locale")}catch{}let locale=saved==="zh"||saved==="en"?saved:navigator.language.toLowerCase().startsWith("zh")?"zh":"en";
  function place(menu,trigger){const h=header.getBoundingClientRect(),b=trigger.getBoundingClientRect(),w=168;menu.style.left=`${Math.max(h.left,Math.min(b.left+b.width/2-w/2,h.right-w))}px`;menu.style.top=`${h.bottom+8}px`}
  function render(){const t=labels[locale];document.querySelectorAll("[data-nav]").forEach(node=>node.textContent=t[node.dataset.nav]);document.querySelectorAll("[data-theme-label]").forEach(node=>node.textContent=t[node.dataset.themeLabel]);localeLabel.textContent=locale==="zh"?"简体中文":"English";localeTrigger.setAttribute("aria-label",t.language);themeTrigger.setAttribute("aria-label",t.theme);document.querySelectorAll("[data-locale]").forEach(button=>button.setAttribute("aria-checked",String(button.dataset.locale===locale)));const theme=document.documentElement.dataset.theme||"system";document.querySelectorAll("[data-theme]").forEach(button=>button.setAttribute("aria-checked",String(button.dataset.theme===theme)))}
  document.querySelectorAll("[data-locale]").forEach(button=>button.addEventListener("click",()=>{locale=button.dataset.locale;try{localStorage.setItem("clipclop-locale",locale)}catch{}render();localeMenu.hidePopover();window.dispatchEvent(new CustomEvent("clipclop:locale",{detail:locale}))}));document.querySelectorAll("[data-theme]").forEach(button=>button.addEventListener("click",()=>{const theme=button.dataset.theme;theme==="system"?delete document.documentElement.dataset.theme:document.documentElement.dataset.theme=theme;try{theme==="system"?localStorage.removeItem("clipclop-theme"):localStorage.setItem("clipclop-theme",theme)}catch{}render();colorMenu.hidePopover();window.dispatchEvent(new Event("clipclop:theme"))}));localeMenu.addEventListener("beforetoggle",event=>{if(event.newState==="open")place(localeMenu,localeTrigger)});colorMenu.addEventListener("beforetoggle",event=>{if(event.newState==="open")place(colorMenu,themeTrigger)});render();fetch("https://api.github.com/repos/hiQianFan/ClipClop").then(response=>response.ok?response.json():Promise.reject()).then(data=>document.querySelector("#global-stars").textContent=Number(data.stargazers_count).toLocaleString()).catch(()=>{});
</script>
