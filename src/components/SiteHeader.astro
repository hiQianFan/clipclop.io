---
import { site, type Locale } from "../i18n";
import { Check, ChevronDown, Download, Languages, Menu, Monitor, Moon, PackageOpen, ShieldCheck, Star, Sun, X } from "@lucide/astro";
interface Props { locale: Locale; current?: "home" | "download" | "changelog" | "privacy"; }
const { locale, current = "home" } = Astro.props;
const home = `/${locale}`;
const nav = site[locale].nav;
const route = (page) => `${home}/${page}`;
const suffix = Astro.url.pathname.replace(/^\/(zh|en)/, "").replace(/\/$/, "");
const localeRoute = (next) => `/${next}${suffix}${Astro.url.search}`;
---
<header class="global-header"><div class="header-left"><a class="global-brand" href={home}><img src="/favicon.png" alt=""><span>ClipClop</span></a><a class="github-star" href="https://github.com/hiQianFan/ClipClop" target="_blank" rel="noopener noreferrer" aria-label="Star ClipClop on GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.84a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg><b data-star-count></b><Star class="star-accent" strokeWidth={1.25}/></a></div><nav class="global-nav" aria-label={nav.primary}><a href={route("download")} aria-current={current === "download" ? "page" : undefined}><Download/><span data-nav="download">{nav.download}</span></a><a href={route("changelog")} aria-current={current === "changelog" ? "page" : undefined}><PackageOpen/><span data-nav="changelog">{nav.changelog}</span></a><a href={route("privacy")} aria-current={current === "privacy" ? "page" : undefined}><ShieldCheck/><span data-nav="privacy">{nav.privacy}</span></a><button class="locale-trigger" type="button" popovertarget="locale-menu" aria-label={nav.language}><Languages/><span class="locale-label">{nav.currentLanguage}</span><ChevronDown class="chevron"/></button><button class="theme-trigger" type="button" popovertarget="color-menu" aria-label={nav.theme}><Monitor class="theme-icon system"/><Sun class="theme-icon light"/><Moon class="theme-icon dark"/></button><button class="more-trigger" type="button" popovertarget="more-menu" aria-label={nav.more}><Menu strokeWidth={2.4}/></button></nav></header>
<div class="global-menu locale-menu" id="locale-menu" popover><a href={localeRoute("zh")} data-locale="zh"><span>简体中文</span><Check class="check"/></a><a href={localeRoute("en")} data-locale="en"><span>English</span><Check class="check"/></a></div>
<div class="global-menu color-menu" id="color-menu" popover><button type="button" data-theme="system"><Monitor/><span data-theme-label="system">{nav.system}</span><Check class="check"/></button><button type="button" data-theme="light"><Sun/><span data-theme-label="light">{nav.light}</span><Check class="check"/></button><button type="button" data-theme="dark"><Moon/><span data-theme-label="dark">{nav.dark}</span><Check class="check"/></button></div>
<div class="global-menu more-menu" id="more-menu" popover><div class="mobile-menu-head"><a class="global-brand" href={home}><img src="/favicon.png" alt=""><span>ClipClop</span></a><a class="github-star" href="https://github.com/hiQianFan/ClipClop" target="_blank" rel="noopener noreferrer" aria-label="Star ClipClop on GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.84a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg><b data-star-count></b><Star class="star-accent" strokeWidth={1.25}/></a><button class="menu-close" type="button" popovertarget="more-menu" popovertargetaction="hide" aria-label={nav.close}><Menu class="menu-close-from" strokeWidth={2.4}/><X class="menu-close-to" strokeWidth={2}/></button></div><nav class="mobile-destinations" aria-label={nav.mobile}><a href={route("download")} aria-current={current === "download" ? "page" : undefined}><Download/><span data-mobile-nav="download">{nav.download}</span></a><a href={route("changelog")} aria-current={current === "changelog" ? "page" : undefined}><PackageOpen/><span data-mobile-nav="changelog">{nav.changelog}</span></a><a href={route("privacy")} aria-current={current === "privacy" ? "page" : undefined}><ShieldCheck/><span data-mobile-nav="privacy">{nav.privacy}</span></a></nav><div class="mobile-settings"><details><summary><Languages/><span data-mobile-label="language">{nav.languageLabel}</span><ChevronDown/></summary><div class="mobile-options"><a href={localeRoute("zh")} data-locale="zh"><span>简体中文</span><Check class="check"/></a><a href={localeRoute("en")} data-locale="en"><span>English</span><Check class="check"/></a></div></details><details><summary><Monitor/><span data-mobile-label="appearance">{nav.appearance}</span><ChevronDown/></summary><div class="mobile-options"><button type="button" data-theme="system"><Monitor/><span data-theme-label="system">{nav.system}</span><Check class="check"/></button><button type="button" data-theme="light"><Sun/><span data-theme-label="light">{nav.light}</span><Check class="check"/></button><button type="button" data-theme="dark"><Moon/><span data-theme-label="dark">{nav.dark}</span><Check class="check"/></button></div></details></div></div>
<style>
  .global-header{width:min(var(--site-max-width,1440px),calc(100vw - 2 * var(--site-gutter,24px)));height:52px;position:fixed;z-index:10;inset:12px 0 auto;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:0 7px 0 10px;border-radius:14px;background:var(--bg-raised);box-shadow:var(--panel-shadow)}.global-brand{height:38px;display:flex;align-items:center;gap:8px;padding:0 8px;border-radius:8px;color:var(--text-1);font-weight:650;text-decoration:none}.global-brand:hover,.global-nav a:hover,.global-nav button:hover{background:var(--bg-hover)}.global-brand img{width:25px;height:25px;border-radius:6px}.global-nav{height:100%;display:flex;align-items:center;gap:2px}.global-nav a,.global-nav>button{height:38px;display:flex;align-items:center;justify-content:center;gap:7px;padding:0 11px;border:0;border-radius:8px;color:var(--text-2);background:transparent;font-size:13px;text-decoration:none;white-space:nowrap;transition:color var(--dur-fast) var(--ease-out),background var(--dur-fast) var(--ease-out)}.global-nav a:nth-child(1){width:104px}.global-nav a:nth-child(2){width:126px}.global-nav a:nth-child(3){width:100px}.global-nav a[aria-current]{color:var(--text-1);background:var(--bg-selected)}.global-nav a:hover,.global-nav>button:hover{color:var(--text-1)}.global-nav svg,.global-menu svg{width:15px;height:15px;flex:none}.locale-trigger{width:112px;position:relative;margin-left:5px;font:11px var(--mono)}.locale-trigger:before{width:1px;height:20px;position:absolute;left:-3px;background:var(--hairline);content:""}.locale-trigger .chevron{width:12px}.theme-trigger{width:38px;padding:0!important}.theme-icon{display:none}:root:not([data-theme]) .theme-icon.system,:root[data-theme=light] .theme-icon.light,:root[data-theme=dark] .theme-icon.dark{display:block}.global-menu{width:168px;inset:auto;margin:0;padding:5px;border:0;border-radius:8px;color:var(--text-1);background:var(--bg-raised);box-shadow:var(--panel-shadow)}.global-menu::backdrop{background:transparent}.global-menu button{width:100%;height:38px;display:flex;align-items:center;gap:9px;padding:0 10px;border:0;border-radius:6px;color:var(--text-2);background:transparent;font-size:13px;text-align:left;cursor:pointer}.global-menu button:hover{color:var(--text-1);background:var(--bg-hover)}.global-menu button span{flex:1}.global-menu .check{opacity:0}.global-menu button[aria-checked=true]{color:var(--text-1)}.global-menu button[aria-checked=true] .check{opacity:1}@media(max-width:768px){.global-header{width:calc(100vw - 20px)}}@media(max-width:600px){.global-header{height:54px;inset-block-start:8px;padding-inline:6px}.global-brand{padding-inline:6px}.global-brand span,.global-nav a span,.locale-trigger span,.locale-trigger .chevron{display:none}.global-nav a,.global-nav>button{width:44px!important;height:44px;padding:0}.locale-trigger{margin-left:0}.locale-trigger:before{display:none}}
  .header-left{display:flex;align-items:center;gap:8px}.github-star{height:38px;display:flex;align-items:center;gap:6px;padding:0 8px;border-radius:var(--radius-md);color:var(--text-2);font:11px var(--mono);text-decoration:none}.github-star:hover{color:var(--text-1)}.github-star>svg:first-child{width:15px;height:15px}.star-accent{width:18px;height:18px;color:#f5c518;fill:#f5c518;stroke:#f5c518}.github-star b{font:inherit;font-variant-numeric:tabular-nums;text-align:right}
</style>
<style>
  .more-trigger,.more-menu{display:none!important}.more-menu:popover-open{display:block!important}.mobile-menu-head,.mobile-settings{display:none}.mobile-destinations a{width:100%;height:38px;display:flex;align-items:center;gap:9px;padding:0 10px;border-radius:var(--radius-md);color:var(--text-2);text-decoration:none;font:600 var(--fs-ui)/var(--lh-snug) var(--sans)}.mobile-destinations a:hover,.mobile-destinations a[aria-current]{color:var(--text-1);background:var(--bg-hover)}
  @media(max-width:600px){.header-left{display:contents}.global-brand{margin-right:auto}.header-left .github-star{display:flex}.global-brand span{display:inline}.global-nav>a:not(.more-trigger),.global-nav>.locale-trigger,.global-nav>.theme-trigger{display:none!important}.global-nav>.more-trigger{width:44px!important;height:44px;display:flex!important}.more-menu{width:100%;height:100dvh;max-width:none;max-height:none;position:fixed;inset:0;margin:0;padding:max(8px,env(safe-area-inset-top)) 10px max(20px,env(safe-area-inset-bottom));border-radius:0;background:var(--bg-shell);overflow:auto}.mobile-menu-head{height:54px;display:flex;align-items:center;padding:0 6px;border:0;border-radius:14px;background:var(--bg-raised);box-shadow:var(--panel-shadow)}.mobile-menu-head .global-brand{padding-inline:6px}.mobile-menu-head .github-star{margin-left:auto}.menu-close{width:44px!important;height:44px!important;margin-left:2px;padding:0!important;display:grid!important;place-items:center;border:0;border-radius:8px;color:var(--text-1)!important;background:transparent!important}.menu-close:hover{background:var(--bg-hover)!important}.menu-close svg{width:22px;height:22px}.mobile-destinations,.mobile-settings{margin-inline:10px}.mobile-destinations{display:flex;flex-direction:column;padding:18px 0 12px;border-bottom:1px solid var(--hairline)}.mobile-destinations a{height:48px;padding:0 8px;font-size:16px}.mobile-destinations svg,.mobile-settings summary>svg:first-child{width:19px;height:19px}.mobile-settings{display:block;padding-top:6px}.mobile-settings details{border-bottom:1px solid var(--hairline)}.mobile-settings summary{height:48px;display:flex;align-items:center;gap:12px;padding:0 8px;color:var(--text-2);font-size:16px;cursor:pointer;list-style:none}.mobile-settings summary::-webkit-details-marker{display:none}.mobile-settings summary span{flex:1}.mobile-settings summary svg:last-child{transition:transform var(--dur-fast) var(--ease-out)}.mobile-settings details[open] summary{color:var(--text-1)}.mobile-settings details[open] summary svg:last-child{transform:rotate(180deg)}.mobile-options{padding:0 0 8px 28px}.mobile-options button{height:42px;font-size:14px}}
</style>
<style>
  .github-star{flex:none}
  @media(max-width:600px){.more-menu{opacity:0;transition:opacity var(--dur-mid,160ms) var(--ease-out),display var(--dur-mid,160ms) allow-discrete,overlay var(--dur-mid,160ms) allow-discrete}.more-menu:popover-open{opacity:1}.mobile-destinations,.mobile-settings{opacity:0;transform:translateY(-10px);transition:opacity var(--dur-mid,160ms) var(--ease-out),transform var(--dur-mid,160ms) var(--ease-out)}.more-menu:popover-open .mobile-destinations,.more-menu:popover-open .mobile-settings{opacity:1;transform:none;transition-delay:40ms}.menu-close{position:relative}.menu-close svg{position:absolute;transition:opacity var(--dur-fast,140ms) var(--ease-out),transform var(--dur-fast,140ms) var(--ease-out)}.menu-close-from{opacity:1;transform:none}.menu-close-to{opacity:0;transform:rotate(-45deg) scale(.72)}.more-menu:popover-open .menu-close-from{opacity:0;transform:rotate(45deg) scale(.72)}.more-menu:popover-open .menu-close-to{opacity:1;transform:none}@starting-style{.more-menu:popover-open{opacity:0}.more-menu:popover-open .mobile-destinations,.more-menu:popover-open .mobile-settings{opacity:0;transform:translateY(-10px)}.more-menu:popover-open .menu-close-from{opacity:1;transform:none}.more-menu:popover-open .menu-close-to{opacity:0;transform:rotate(-45deg) scale(.72)}}}
  @media(max-width:600px){.global-nav>.more-trigger svg,.menu-close svg{width:20px!important;height:20px!important}.menu-close{margin-left:0!important}.mobile-menu-head .star-accent{width:18px!important;height:18px!important}}
  @media(prefers-reduced-motion:reduce){.more-menu,.mobile-destinations,.mobile-settings,.menu-close svg,.mobile-settings summary svg:last-child{transition:none!important}}
</style>
<style>
  .locale-menu a,.mobile-options a{width:100%;height:38px;display:flex;align-items:center;gap:9px;padding:0 10px;border-radius:6px;color:var(--text-2);font-size:13px;text-decoration:none}
  .locale-menu a:hover,.mobile-options a:hover{color:var(--text-1);background:var(--bg-hover)}
  .locale-menu a span,.mobile-options a span{flex:1}.locale-menu a .check{opacity:0}.locale-menu a[aria-current] .check{opacity:1}
</style>
<script>
  const header=document.querySelector(".global-header"),localeMenu=document.querySelector("#locale-menu"),colorMenu=document.querySelector("#color-menu"),localeTrigger=document.querySelector(".locale-trigger"),themeTrigger=document.querySelector(".theme-trigger");
  let locale=location.pathname.startsWith("/zh")?"zh":"en";
  function place(menu,trigger){const h=header.getBoundingClientRect(),w=168;if(matchMedia("(max-width:600px)").matches){menu.style.left=`${innerWidth-w-10}px`;menu.style.top=`${h.bottom+8}px`;return}const b=trigger.getBoundingClientRect();menu.style.left=`${Math.max(h.left,Math.min(b.left+b.width/2-w/2,h.right-w))}px`;menu.style.top=`${h.bottom+8}px`}
  function render(){document.querySelectorAll("a[data-locale]").forEach(link=>link.dataset.locale===locale?link.setAttribute("aria-current","true"):link.removeAttribute("aria-current"));const theme=document.documentElement.dataset.theme||"system";document.querySelectorAll("button[data-theme]").forEach(button=>button.setAttribute("aria-checked",String(button.dataset.theme===theme)))}
  document.querySelectorAll("a[data-locale]").forEach(link=>link.addEventListener("click",()=>{try{localStorage.setItem("clipclop-locale",link.dataset.locale)}catch{}if(location.hash)link.hash=location.hash}));document.querySelectorAll("button[data-theme]").forEach(button=>button.addEventListener("click",()=>{const theme=button.dataset.theme;theme==="system"?document.documentElement.removeAttribute("data-theme"):document.documentElement.dataset.theme=theme;try{theme==="system"?localStorage.removeItem("clipclop-theme"):localStorage.setItem("clipclop-theme",theme)}catch{}render();colorMenu.hidePopover();window.dispatchEvent(new Event("clipclop:theme"))}));localeMenu.addEventListener("beforetoggle",event=>{if(event.newState==="open")place(localeMenu,localeTrigger)});colorMenu.addEventListener("beforetoggle",event=>{if(event.newState==="open")place(colorMenu,themeTrigger)});render();const starKey="clipclop-github-stars",starMaxAge=216e5,showStars=count=>document.querySelectorAll("[data-star-count]").forEach(node=>node.textContent=Number(count).toLocaleString());let starCache;try{starCache=JSON.parse(localStorage.getItem(starKey))}catch{}if(Number.isFinite(starCache?.count))showStars(starCache.count);if(!starCache||Date.now()-starCache.cachedAt>starMaxAge)fetch("https://api.github.com/repos/hiQianFan/ClipClop").then(response=>response.ok?response.json():Promise.reject()).then(data=>{showStars(data.stargazers_count);try{localStorage.setItem(starKey,JSON.stringify({count:data.stargazers_count,cachedAt:Date.now()}))}catch{}}).catch(()=>{});
</script>
