---
import { site, type Locale } from "../i18n";
interface Props { locale: Locale; }
const { locale } = Astro.props;
const route = (page) => `/${locale}/${page}`;
const nav = site[locale].nav;
---
<footer class="site-footer"><nav data-footer-nav aria-label={nav.footer}><a href={route("download")} data-footer="download">{nav.download}</a><a href={route("changelog")} data-footer="changelog">{nav.changelog}</a><a href={route("privacy")} data-footer="privacy">{nav.privacy}</a><a href="https://github.com/hiQianFan/ClipClop" target="_blank" rel="noopener noreferrer">GitHub</a></nav><p><a href="https://github.com/hiQianFan/ClipClop/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">AGPL-3.0</a><span>© {new Date().getFullYear()} ClipClop</span></p></footer>
<style>.site-footer{width:min(var(--site-max-width,1440px),calc(100vw - 2 * var(--site-gutter,24px)));margin:0 auto;padding:28px 0 40px;border-top:1px solid var(--hairline);color:var(--text-2);font-size:13px}.site-footer,.site-footer nav,.site-footer p{display:flex;align-items:center;gap:20px}.site-footer{justify-content:space-between}.site-footer p{margin:0}.site-footer a{color:inherit;text-decoration:none}.site-footer a:hover{color:var(--text-1)}@media(max-width:600px){.site-footer{align-items:flex-start;flex-direction:column}.site-footer nav{flex-wrap:wrap}.site-footer p{width:100%;justify-content:space-between}}</style>
