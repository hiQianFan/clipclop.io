<style>.site-footer{width:min(var(--site-max-width,1440px),calc(100vw - 2 * var(--site-gutter,24px)));margin:0 auto;padding:28px 0 40px;border-top:1px solid var(--hairline);color:var(--text-2);font-size:13px}.site-footer,.site-footer nav,.site-footer p{display:flex;align-items:center;gap:20px}.site-footer{justify-content:space-between}.site-footer p{margin:0}.site-footer a{color:inherit;text-decoration:none}.site-footer a:hover{color:var(--text-1)}@media(max-width:600px){.site-footer{align-items:flex-start;flex-direction:column}.site-footer nav{flex-wrap:wrap}.site-footer p{width:100%;justify-content:space-between}}</style>
<script>const footerCopy={zh:{download:"下载",changelog:"更新日志",privacy:"隐私说明",nav:"页脚导航"},en:{download:"Download",changelog:"Changelog",privacy:"Privacy",nav:"Footer navigation"}};function renderFooter(locale){const copy=footerCopy[locale];document.querySelectorAll("[data-footer]").forEach(link=>link.textContent=copy[link.dataset.footer]);document.querySelector("[data-footer-nav]").setAttribute("aria-label",copy.nav)}let footerLocale;try{footerLocale=localStorage.getItem("clipclop-locale")}catch{}renderFooter(footerLocale==="zh"||footerLocale==="en"?footerLocale:navigator.language.toLowerCase().startsWith("zh")?"zh":"en");window.addEventListener("clipclop:locale",event=>renderFooter(event.detail));</script>
