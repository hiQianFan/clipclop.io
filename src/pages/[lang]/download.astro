---
import LocalizedLayout from "../../layouts/LocalizedLayout.astro";
import { locales, download, type Locale } from "../../i18n";
export function getStaticPaths() { return locales.map(locale => ({ params: { lang: locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
const c = download[locale];
---
<LocalizedLayout locale={locale} page="download" title={c.title} description={c.description} stylesheet="/styles/download.css">
  <main class="download"><h1>{c.heading}</h1><p class="intro">{c.intro}</p><div class="platforms"><article class="platform" data-platform="mac"><span class="preferred">{c.preferred}</span><h2>macOS</h2><p>{c.macDetail}</p><p class="install-note">{c.macNote}</p><a class="button" href="/download/macos">{c.macAction}</a></article><article class="platform" data-platform="windows"><span class="preferred">{c.preferred}</span><h2>Windows</h2><p>{c.windowsDetail}</p><p class="install-note">{c.windowsNote}</p><a class="button" href="/download/windows">{c.windowsAction}</a></article></div><p class="note">{c.noteBefore} <a href={`/${locale}/changelog`}>{c.noteLink}</a>。</p></main>
  <script slot="scripts" is:inline>const platform=/Windows/i.test(navigator.userAgent)?"windows":/Mac|iPhone|iPad/i.test(navigator.userAgent)?"mac":null;if(platform)document.querySelector(`[data-platform="${platform}"]`)?.classList.add("is-preferred");</script>
</LocalizedLayout>
