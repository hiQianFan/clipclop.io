---
import DownloadPage from "../../features/download/DownloadPage.astro";
import { locales, type Locale } from "../../i18n/config";

export function getStaticPaths() { return locales.map(locale => ({ params: { lang: locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
---
<DownloadPage locale={locale}/>
