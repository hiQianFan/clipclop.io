---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="description" content="下载 ClipClop for macOS 或 Windows。"><meta name="color-scheme" content="light dark"><title>下载 — ClipClop</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"><script is:inline>try{const theme=localStorage.getItem("clipclop-theme");if(theme==="light"||theme==="dark")document.documentElement.dataset.theme=theme}catch{}</script><style is:global>
  :root{color-scheme:light dark;--site-max-width:1440px;--site-gutter:clamp(20px,4vw,64px);--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-hover:#fff;--action-on:#17181a;--mono:ui-monospace,"SF Mono","Cascadia Code",Consolas,monospace;--sans:-apple-system,BlinkMacSystemFont,"Segoe UI Variable","Segoe UI",system-ui,sans-serif;--radius-md:6px;--radius-xl:14px;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3);--dur-fast:140ms;--ease-out:cubic-bezier(.16,1,.3,1)}@media(prefers-color-scheme:light){:root{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-hover:#34383c;--action-on:#fff;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2)}}:root[data-theme=dark]{--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-hover:#fff;--action-on:#17181a;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3)}:root[data-theme=light]{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-hover:#34383c;--action-on:#fff;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2)}*{box-sizing:border-box}body{margin:0;color:var(--text-1);background:var(--bg-shell);font-family:var(--sans);-webkit-font-smoothing:antialiased}:focus-visible{outline:2px solid var(--text-1);outline-offset:3px}.download{width:min(980px,calc(100vw - 2 * var(--site-gutter)));min-height:calc(100svh - 100px);margin:0 auto;padding:150px 0 110px}.download h1{max-width:780px;margin:0;font-size:clamp(3.5rem,9vw,7rem);line-height:.95;letter-spacing:-.05em}.intro{max-width:630px;margin:28px 0 52px;color:var(--text-2);font-size:19px;line-height:1.65}.platforms{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.platform{padding:28px;border:1px solid var(--hairline);border-radius:var(--radius-xl);background:var(--bg-raised)}.platform[data-preferred=true]{border-color:var(--text-2)}.platform h2{margin:0 0 8px;font-size:24px}.platform p{min-height:48px;margin:0 0 24px;color:var(--text-2);line-height:1.6}.button{min-height:44px;display:inline-flex;align-items:center;padding:0 17px;border-radius:var(--radius-md);color:var(--action-on);background:var(--action);font-weight:650;text-decoration:none}.button:hover{background:var(--action-hover)}.note{margin:28px 0 0;color:var(--text-3);font:12px/1.6 var(--mono)}@media(max-width:650px){.download{padding-top:116px}.platforms{grid-template-columns:1fr}.platform p{min-height:0}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style></head><body><SiteHeader current="download"/><main class="download"><h1>下载 ClipClop</h1><p class="intro">选择你的系统。两个平台始终都可以下载，不需要注册，也不会跳转到第三方下载页。</p><div class="platforms"><article class="platform" data-platform="mac"><h2>macOS</h2><p>Universal 安装包，适用于 Apple Silicon 与 Intel Mac。</p><a class="button" href="/download/macos">下载 macOS 版</a></article><article class="platform" data-platform="windows"><h2>Windows</h2><p>x64 安装程序。</p><a class="button" href="/download/windows">下载 Windows 版</a></article></div><p class="note">正式下载由 ClipClop 的 Cloudflare/R2 分发入口提供。版本记录可在 <a href="/changelog">更新日志</a> 中查看。</p></main><SiteFooter/><script>const platform=/Mac|iPhone|iPad/.test(navigator.platform)?"mac":/Win/.test(navigator.platform)?"windows":"";document.querySelector(`[data-platform="${platform}"]`)?.setAttribute("data-preferred","true")</script></body></html>
