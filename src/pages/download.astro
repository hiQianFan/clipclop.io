---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="description" content="下载 ClipClop for macOS 或 Windows。"><meta name="color-scheme" content="light dark"><title>下载 — ClipClop</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"><script is:inline>try{const theme=localStorage.getItem("clipclop-theme");if(theme==="light"||theme==="dark")document.documentElement.dataset.theme=theme}catch{}</script><style is:global>
  :root{color-scheme:light dark;--site-max-width:1440px;--site-gutter:clamp(20px,4vw,64px);--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-hover:#fff;--action-on:#17181a;--mono:ui-monospace,"SF Mono","Cascadia Code",Consolas,monospace;--sans:-apple-system,BlinkMacSystemFont,"Segoe UI Variable","Segoe UI",system-ui,sans-serif;--radius-md:6px;--radius-xl:14px;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3);--dur-fast:140ms;--ease-out:cubic-bezier(.16,1,.3,1)}@media(prefers-color-scheme:light){:root{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-hover:#34383c;--action-on:#fff;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2)}}:root[data-theme=dark]{--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-hover:#fff;--action-on:#17181a;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3)}:root[data-theme=light]{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-hover:#34383c;--action-on:#fff;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2)}*{box-sizing:border-box}body{margin:0;color:var(--text-1);background:var(--bg-shell);font-family:var(--sans);-webkit-font-smoothing:antialiased}:focus-visible{outline:2px solid var(--text-1);outline-offset:3px}.download{width:min(980px,calc(100vw - 2 * var(--site-gutter)));min-height:calc(100svh - 100px);margin:0 auto;padding:150px 0 110px}.download h1{max-width:780px;margin:0;font-size:clamp(3.5rem,9vw,7rem);line-height:.95;letter-spacing:-.05em}.intro{max-width:680px;margin:28px 0 52px;color:var(--text-2);font-size:19px;line-height:1.65}.platforms{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.platform{position:relative;padding:28px;border:1px solid var(--hairline);border-radius:var(--radius-xl);background:var(--bg-raised)}.platform[data-preferred=true]{border-color:var(--text-2)}.preferred{display:none;position:absolute;top:28px;right:28px;color:var(--text-3);font:11px var(--mono)}.platform[data-preferred=true] .preferred{display:block}.platform h2{margin:0 0 8px;font-size:24px}.platform p{min-height:48px;margin:0 0 16px;color:var(--text-2);line-height:1.6}.install-note{min-height:58px!important;font-size:13px}.button{min-height:44px;display:inline-flex;align-items:center;padding:0 17px;border-radius:var(--radius-md);color:var(--action-on);background:var(--action);font-weight:650;text-decoration:none;white-space:nowrap}.button:hover{background:var(--action-hover)}.note{margin:28px 0 0;color:var(--text-3);font:12px/1.6 var(--mono)}@media(max-width:650px){.download{padding-top:116px}.platforms{grid-template-columns:1fr}.platform p,.install-note{min-height:0!important}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style><style is:global>.download{width:min(1000px,calc(100vw - 2 * var(--site-gutter)));padding:148px 0 100px}.download h1{margin:0 0 18px}.intro{margin:0 0 54px;font-size:17px}.platform h2{line-height:1.3}.platform p{font-size:14px}@media(max-width:650px){.download{padding-top:112px}}</style></head><body><SiteHeader current="download"/><main class="download"><h1 data-copy="title">下载 ClipClop</h1><p class="intro" data-copy="intro">选择你的系统。两个平台始终都可以下载，不需要注册，也不会跳转到第三方下载页。</p><div class="platforms"><article class="platform" data-platform="mac"><span class="preferred" data-copy="preferred">适合当前设备</span><h2>macOS</h2><p data-copy="macDetail">Universal 安装包，适用于 Apple Silicon 与 Intel Mac。</p><p class="install-note" data-copy="macNote">安装包尚未使用 Apple Developer ID 签名，macOS 可能要求你在“隐私与安全性”中批准。</p><a class="button" href="/download/macos" data-copy="macAction">下载 macOS 版</a></article><article class="platform" data-platform="windows"><span class="preferred" data-copy="preferred">适合当前设备</span><h2>Windows</h2><p data-copy="windowsDetail">适用于 64 位 Windows 的 x64 安装程序。</p><p class="install-note" data-copy="windowsNote">安装包尚未使用 Authenticode 签名，Windows 可能显示“未知发布者”或 SmartScreen 提示。</p><a class="button" href="/download/windows" data-copy="windowsAction">下载 Windows 版</a></article></div><p class="note" data-copy="note">下载通过 ClipClop 的 Cloudflare/R2 稳定入口提供；文件名和版本可以更新，公开链接保持不变。版本记录见 <a href="/changelog">更新日志</a>。</p></main><SiteFooter/><script>
  const copy={zh:{title:"下载 ClipClop",intro:"选择你的系统。两个平台始终都可以下载，不需要注册，也不会跳转到第三方下载页。",preferred:"适合当前设备",macDetail:"Universal 安装包，适用于 Apple Silicon 与 Intel Mac。",macNote:"安装包尚未使用 Apple Developer ID 签名，macOS 可能要求你在“隐私与安全性”中批准。",macAction:"下载 macOS 版",windowsDetail:"适用于 64 位 Windows 的 x64 安装程序。",windowsNote:"安装包尚未使用 Authenticode 签名，Windows 可能显示“未知发布者”或 SmartScreen 提示。",windowsAction:"下载 Windows 版",note:'下载通过 ClipClop 的 Cloudflare/R2 稳定入口提供；文件名和版本可以更新，公开链接保持不变。版本记录见 <a href="/changelog">更新日志</a>。'},en:{title:"Download ClipClop",intro:"Choose your system. Both platforms remain available, with no account and no third-party download page.",preferred:"This device",macDetail:"Universal installer for Apple Silicon and Intel Macs.",macNote:"The installer is not yet signed with Apple Developer ID, so macOS may require approval in Privacy & Security.",macAction:"Download for macOS",windowsDetail:"x64 installer for 64-bit Windows.",windowsNote:"The installer is not yet Authenticode-signed, so Windows may show Unknown Publisher or SmartScreen.",windowsAction:"Download for Windows",note:'Downloads use ClipClop’s stable Cloudflare/R2 routes; filenames and versions may change while the public links remain stable. See the <a href="/changelog">changelog</a>.'}};
  function render(locale){const t=copy[locale];document.documentElement.lang=locale==="zh"?"zh-CN":"en";document.title=locale==="zh"?"下载 — ClipClop":"Download — ClipClop";document.querySelector('meta[name="description"]').content=locale==="zh"?"下载适用于 macOS 或 Windows 的 ClipClop。":"Download ClipClop for macOS or Windows.";document.querySelectorAll("[data-copy]").forEach(node=>node.innerHTML=t[node.dataset.copy])}
  let saved;try{saved=localStorage.getItem("clipclop-locale")}catch{}render(saved==="zh"||saved==="en"?saved:navigator.language.toLowerCase().startsWith("zh")?"zh":"en");window.addEventListener("clipclop:locale",event=>render(event.detail));const platform=/Mac|iPhone|iPad/.test(navigator.platform)?"mac":/Win/.test(navigator.platform)?"windows":"";document.querySelector(`[data-platform="${platform}"]`)?.setAttribute("data-preferred","true");
</script></body></html>
