---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="description" content="ClipClop 更新日志：新增功能、改进和修复。"><meta name="color-scheme" content="light dark"><title>更新日志 — ClipClop</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"><script is:inline>try{const theme=localStorage.getItem("clipclop-theme");if(theme==="light"||theme==="dark")document.documentElement.dataset.theme=theme}catch{}</script><style is:global>
  :root{color-scheme:light dark;--site-max-width:1440px;--site-gutter:clamp(20px,4vw,64px);--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-on:#17181a;--mono:ui-monospace,"SF Mono","Cascadia Code",Consolas,monospace;--sans:-apple-system,BlinkMacSystemFont,"Segoe UI Variable","Segoe UI",system-ui,sans-serif;--radius-md:6px;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3);--dur-fast:140ms;--ease-out:cubic-bezier(.16,1,.3,1)}@media(prefers-color-scheme:light){:root{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-on:#fff;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2)}}:root[data-theme=dark]{--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-on:#17181a;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3)}:root[data-theme=light]{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-on:#fff;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2)}*{box-sizing:border-box}body{margin:0;color:var(--text-1);background:var(--bg-shell);font-family:var(--sans);-webkit-font-smoothing:antialiased}:focus-visible{outline:2px solid var(--text-1);outline-offset:3px}.changelog{width:min(1000px,calc(100vw - 2 * var(--site-gutter)));min-height:calc(100svh - 100px);margin:0 auto;padding:148px 0 100px}.head{display:grid;grid-template-columns:1fr auto;align-items:end;gap:32px;margin-bottom:54px}.head h1{margin:0 0 18px;font-size:clamp(3.5rem,9vw,7rem);line-height:.95;letter-spacing:-.05em}.head p{max-width:600px;margin:0;color:var(--text-2);font-size:17px;line-height:1.65}.source{padding:11px 13px;border:1px solid var(--hairline);border-radius:var(--radius-md);color:var(--text-2);text-decoration:none;font:12px var(--mono)}.release{display:grid;grid-template-columns:160px 1fr;gap:42px;padding:34px 0;border-top:1px solid var(--hairline)}.version{font:12px/1.6 var(--mono)}.version strong{display:block;color:var(--text-1);font-size:16px}.version time,.status{color:var(--text-3)}.latest{display:inline-block;margin-top:8px;padding:3px 6px;color:var(--action-on);background:var(--action);border-radius:4px}.notes{color:var(--text-2);font-size:14px;line-height:1.75;white-space:pre-wrap}.downloads{display:flex;gap:8px;margin-top:18px}.downloads a{padding:9px 11px;border-radius:var(--radius-md);color:var(--text-1);background:var(--bg-selected);font:11px var(--mono);text-decoration:none}@media(max-width:650px){.changelog{padding-top:112px}.head,.release{grid-template-columns:1fr}.release{gap:18px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style></head><body><SiteHeader current="changelog"/><main class="changelog"><div class="head"><div><h1>更新日志</h1><p>按版本查看 ClipClop 的新增功能、改进和修复。</p></div><a class="source" href="https://github.com/hiQianFan/ClipClop/releases" target="_blank" rel="noopener noreferrer">查看原始记录</a></div><div id="release-list" aria-live="polite"><p class="status">正在读取更新日志…</p></div></main><SiteFooter/><script>
  const list=document.querySelector("#release-list"),esc=value=>value.replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;");fetch("https://api.github.com/repos/hiQianFan/ClipClop/releases?per_page=10").then(r=>{if(!r.ok)throw new Error();return r.json()}).then(data=>{const releases=data.filter(r=>!r.draft);list.innerHTML=releases.map((r,i)=>`<article class="release"><aside class="version"><strong>${esc(r.tag_name)}</strong><time datetime="${r.published_at}">${new Intl.DateTimeFormat("zh-CN",{dateStyle:"medium"}).format(new Date(r.published_at))}</time>${i?"":'<span class="latest">最新版本</span>'}</aside><div><h2>${esc(r.name||r.tag_name)}</h2><div class="notes">${esc(r.body||"此版本没有附加更新说明。")}</div><div class="downloads"><a href="/download/macos">macOS</a><a href="/download/windows">Windows</a></div></div></article>`).join("")||'<p class="status">暂无公开版本。</p>'}).catch(()=>list.innerHTML='<p class="status">暂时无法读取更新日志。你仍然可以前往 <a href="/download">下载页面</a>。</p>')
</script></body></html>
