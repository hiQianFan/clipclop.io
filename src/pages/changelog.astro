---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="description" content="ClipClop 更新日志：新增功能、改进和修复。"><meta name="color-scheme" content="light dark"><title>更新日志 — ClipClop</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"><script is:inline>try{const theme=localStorage.getItem("clipclop-theme");if(theme==="light"||theme==="dark")document.documentElement.dataset.theme=theme}catch{}</script><style is:global>
  :root{color-scheme:light dark;--site-max-width:1440px;--site-gutter:clamp(20px,4vw,64px);--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-on:#17181a;--mono:ui-monospace,"SF Mono","Cascadia Code",Consolas,monospace;--sans:-apple-system,BlinkMacSystemFont,"Segoe UI Variable","Segoe UI",system-ui,sans-serif;--radius-md:6px;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3);--dur-fast:140ms;--ease-out:cubic-bezier(.16,1,.3,1)}@media(prefers-color-scheme:light){:root{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-on:#fff;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2)}}:root[data-theme=dark]{--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-on:#17181a;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3)}:root[data-theme=light]{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-on:#fff;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2)}*{box-sizing:border-box}body{margin:0;color:var(--text-1);background:var(--bg-shell);font-family:var(--sans);-webkit-font-smoothing:antialiased}:focus-visible{outline:2px solid var(--text-1);outline-offset:3px}.changelog{width:min(1000px,calc(100vw - 2 * var(--site-gutter)));min-height:calc(100svh - 100px);margin:0 auto;padding:148px 0 100px}.head{display:grid;grid-template-columns:1fr auto;align-items:end;gap:32px;margin-bottom:54px}.head h1{margin:0 0 18px;font-size:clamp(3.5rem,9vw,7rem);line-height:.95;letter-spacing:-.05em}.head p{max-width:600px;margin:0;color:var(--text-2);font-size:17px;line-height:1.65}.head-actions{display:flex;gap:8px}.source,.download-page{padding:11px 13px;border:1px solid var(--hairline);border-radius:var(--radius-md);color:var(--text-2);text-decoration:none;font:12px var(--mono);white-space:nowrap}.download-page{color:var(--action-on);background:var(--action);border-color:transparent}.release{display:grid;grid-template-columns:160px 1fr;gap:42px;padding:34px 0;border-top:1px solid var(--hairline)}.release h2 a{color:inherit;text-decoration:none}.release h2 a:hover{text-decoration:underline;text-underline-offset:4px}.version{font:12px/1.6 var(--mono)}.version strong{display:block;color:var(--text-1);font-size:16px}.version time,.status{color:var(--text-3)}.latest{display:inline-block;margin-top:8px;padding:3px 6px;color:var(--action-on);background:var(--action);border-radius:4px}.notes{color:var(--text-2);font-size:14px;line-height:1.75}.notes h3{margin:20px 0 8px;color:var(--text-1);font-size:15px}.notes p,.notes ul,.notes ol{margin:8px 0}.notes ul,.notes ol{padding-left:22px}.notes li+li{margin-top:5px}.notes a{color:var(--text-1);text-underline-offset:3px}.notes code{padding:2px 4px;border-radius:4px;background:var(--bg-selected);font:12px var(--mono)}@media(max-width:650px){.changelog{padding-top:112px}.head,.release{grid-template-columns:1fr}.head-actions{flex-wrap:wrap}.release{gap:18px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
  .version{display:grid;grid-template-columns:max-content max-content;grid-template-areas:"version latest" "date date";align-content:start;align-items:center;gap:4px 8px}.version strong{grid-area:version}.version time{grid-area:date}.latest{grid-area:latest;margin-top:0}
</style></head><body><SiteHeader current="changelog"/><main class="changelog"><div class="head"><div><h1 data-copy="title">更新日志</h1><p data-copy="intro">按版本查看 ClipClop 的新增功能、改进和修复。</p></div><div class="head-actions"><a class="download-page" href="/download" data-copy="download">下载</a><a class="source" href="https://github.com/hiQianFan/ClipClop/releases" target="_blank" rel="noopener noreferrer" data-copy="source">查看原始记录</a></div></div><div id="release-list" aria-live="polite"><p class="status" data-copy="loading">正在读取更新日志…</p></div></main><SiteFooter/><script>
  const copy={zh:{title:"更新日志",intro:"按版本查看 ClipClop 的新增功能、改进和修复。",source:"查看原始记录",loading:"正在读取更新日志…",latest:"最新版本",download:"下载",none:"暂无公开版本。",noNotes:"此版本没有附加更新说明。",error:'暂时无法读取更新日志。你仍然可以前往 <a href="/download">下载页面</a>。'},en:{title:"Changelog",intro:"Browse ClipClop features, improvements, and fixes by version.",source:"View original releases",loading:"Loading release history…",latest:"Latest",download:"Download",none:"No public releases yet.",noNotes:"No release notes were provided.",error:'Release history is temporarily unavailable. You can still use the <a href="/download">download page</a>.'}},list=document.querySelector("#release-list"),cacheKey="clipclop-release-history";let locale,releases,failed=false;
  const esc=value=>String(value).replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;"),languageBody=(body,lang)=>{const parts=String(body||"").split(/^> 安装提示 \/ Installation note\s*$/m)[0].split(/^## (中文|English)\s*$/m),label=lang==="zh"?"中文":"English",at=parts.indexOf(label);return at<0?"":parts[at+1].trim()},inline=value=>esc(value).replace(/`([^`]+)`/g,"<code>$1</code>").replace(/\*\*([^*]+)\*\*/g,"<strong>$1</strong>").replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,'<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'),markdown=value=>{const blocks=[];let listType="",items=[];const flush=()=>{if(items.length)blocks.push(`<${listType}>${items.map(item=>`<li>${inline(item)}</li>`).join("")}</${listType}>`);items=[];listType=""};for(const line of value.split("\n")){const item=line.match(/^\s*(-|\d+\.)\s+(.+)/);if(item){const type=item[1]==="-"?"ul":"ol";if(listType&&listType!==type)flush();listType=type;items.push(item[2]);continue}flush();if(/^###\s+/.test(line))blocks.push(`<h3>${inline(line.slice(4))}</h3>`);else if(line.trim()&&!/^---+$/.test(line.trim()))blocks.push(`<p>${inline(line)}</p>`)}flush();return blocks.join("")},render=()=>{const t=copy[locale];document.documentElement.lang=locale==="zh"?"zh-CN":"en";document.title=locale==="zh"?"更新日志 — ClipClop":"Changelog — ClipClop";document.querySelector('meta[name="description"]').content=locale==="zh"?"ClipClop 更新日志：新增功能、改进和修复。":"ClipClop changelog: features, improvements, and fixes.";document.querySelectorAll("[data-copy]").forEach(node=>node.innerHTML=t[node.dataset.copy]);if(releases)list.innerHTML=releases.map((release,index)=>`<article class="release"><aside class="version"><strong>${esc(release.tag_name)}</strong><time datetime="${esc(release.published_at)}">${new Intl.DateTimeFormat(locale==="zh"?"zh-CN":"en",{dateStyle:"medium"}).format(new Date(release.published_at))}</time>${index?"":`<span class="latest">${t.latest}</span>`}</aside><div><h2><a href="${esc(release.html_url)}" target="_blank" rel="noopener noreferrer">${esc(release.name||release.tag_name)}</a></h2><div class="notes">${markdown(languageBody(release.body,locale))||`<p>${t.noNotes}</p>`}</div></div></article>`).join("")||`<p class="status">${t.none}</p>`;else if(failed)list.innerHTML=`<p class="status">${t.error}</p>`};
  console.assert(languageBody("## 中文\n\n### 新增\n- 中文\n\n## English\n\n### Added\n- English\n\n> 安装提示 / Installation note\n> hidden","en")==="### Added\n- English"&&markdown("### Added\n- `safe`")==="<h3>Added</h3><ul><li><code>safe</code></li></ul>","Changelog locale/Markdown rendering failed");
  let saved;try{saved=localStorage.getItem("clipclop-locale");releases=JSON.parse(localStorage.getItem(cacheKey));if(!Array.isArray(releases))releases=null}catch{}locale=saved==="zh"||saved==="en"?saved:navigator.language.toLowerCase().startsWith("zh")?"zh":"en";render();window.addEventListener("clipclop:locale",event=>{locale=event.detail;render()});fetch("https://api.github.com/repos/hiQianFan/ClipClop/releases?per_page=10").then(response=>{if(!response.ok)throw new Error();return response.json()}).then(data=>{releases=data.filter(release=>!release.draft);try{localStorage.setItem(cacheKey,JSON.stringify(releases))}catch{}render()}).catch(()=>{failed=true;render()});
</script></body></html>
