---
import { ArrowLeft, ArrowRight, Code2, Compass, Download, File, Folder, Image, MonitorSmartphone, SlidersHorizontal, SquareTerminal } from "@lucide/astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
const macDownload = "/download/macos";
const windowsDownload = "/download/windows";
---
<!doctype html>
<html lang="en" data-locale="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="description" content="ClipClop — Clip-clip, clop-clop. Two steps, fast. Everything you copy, saved locally forever. Never lost. Clipboard history for macOS and Windows.">
  <link rel="canonical" href="https://clipclop.io/en">
  <link rel="alternate" hreflang="zh" href="https://clipclop.io/zh"><link rel="alternate" hreflang="en" href="https://clipclop.io/en"><link rel="alternate" hreflang="x-default" href="https://clipclop.io/en"><meta property="og:locale" content="en_US">
  <meta property="og:type" content="website"><meta property="og:site_name" content="ClipClop"><meta property="og:title" content="ClipClop — Clip-clip, clop-clop. Two steps, fast."><meta property="og:description" content="ClipClop — Clip-clip, clop-clop. Two steps, fast. Everything you copy, saved locally forever. Never lost. Clipboard history for macOS and Windows."><meta property="og:url" content="https://clipclop.io/en"><meta property="og:image" content="https://clipclop.io/hero-logo.webp"><meta property="og:image:alt" content="ClipClop app icon">
  <meta name="twitter:card" content="summary"><meta name="twitter:title" content="ClipClop — Clip-clip, clop-clop. Two steps, fast."><meta name="twitter:description" content="ClipClop — Clip-clip, clop-clop. Two steps, fast. Everything you copy, saved locally forever. Never lost. Clipboard history for macOS and Windows."><meta name="twitter:image" content="https://clipclop.io/hero-logo.webp">
  <meta name="color-scheme" content="light dark"><meta name="theme-color" content="#17181a" media="(prefers-color-scheme: dark)"><meta name="theme-color" content="#f2f3f4" media="(prefers-color-scheme: light)">
  <title>ClipClop — Clip-clip, clop-clop. Two steps, fast.</title>
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/favicon.png">
  <script is:inline>try{const theme=localStorage.getItem("clipclop-theme");if(theme==="light"||theme==="dark")document.documentElement.dataset.theme=theme}catch{}</script>
  <link rel="stylesheet" href="/styles/index.css">

</head>
<body>
<template id="icon-browser"><Compass size={15} strokeWidth={1.8} /></template>
<template id="icon-folder"><Folder size={15} strokeWidth={1.8} /></template>
<template id="icon-image"><Image size={15} strokeWidth={1.8} /></template>
<template id="icon-terminal"><SquareTerminal size={15} strokeWidth={1.8} /></template>
<template id="icon-code"><Code2 size={15} strokeWidth={1.8} /></template>
<template id="icon-device"><MonitorSmartphone size={15} strokeWidth={1.8} /></template>
<template id="icon-file"><File size={18} strokeWidth={1.7} /></template>
<SiteHeader current="home" />
<main>
  <section class="hero" id="home" aria-labelledby="hero-title"><div class="hero-inner">
    <div class="hero-copy"><h1 id="hero-title">ClipClop</h1><div class="hero-shortcuts" data-i18n-group="shortcuts"><span class="shortcut-hint"><kbd id="open-shortcut">⌃⌘C</kbd> <span data-i18n="shortcut-open">Open</span></span><span class="shortcut-hint"><kbd>↵</kbd> <span data-i18n="shortcut-paste">Paste</span></span></div><p class="tagline" data-i18n="tagline">Clip-clip, clop-clop. Two steps, fast.<br>Everything you copy, saved locally forever. Never lost.</p></div>
    <div class="hero-actions"><a class="primary platform-download" href={macDownload} aria-label="Download ClipClop for macOS"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.7 13.5c0-2.4 2-3.6 2.1-3.7a4.5 4.5 0 0 0-3.5-1.9c-1.5-.2-2.9.9-3.7.9-.8 0-2-.9-3.3-.9a4.9 4.9 0 0 0-4.1 2.5c-1.8 3-.5 7.5 1.2 10 .9 1.2 1.8 2.5 3.2 2.4 1.3-.1 1.8-.8 3.4-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.2 3.1-2.4 1-1.4 1.4-2.8 1.4-2.9-.1 0-3.2-1.2-3.2-4M14.3 6.3A4.1 4.1 0 0 0 15.2 3a4.2 4.2 0 0 0-2.8 1.4 3.8 3.8 0 0 0-1 3 3.5 3.5 0 0 0 2.9-1.1"/></svg><span data-i18n="mac">Download for macOS</span></a><a class="secondary-download platform-download" href={windowsDownload} aria-label="Download ClipClop for Windows"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 5.3 10.6 4v7.3H3V5.3Zm8.5-1.5L21 2.4v8.9h-9.5V3.8ZM3 12.2h7.6v7.4L3 18.3v-6.1Zm8.5 0H21v9.4l-9.5-1.7v-7.7Z"/></svg><span data-i18n="windows">Download for Windows</span></a></div>
    <img class="logo" src="/hero-logo.webp" width="680" height="680" alt="ClipClop cow and horse app icon">
  </div></section>
  <section class="showcase" id="demo" aria-label="Interactive ClipClop preview">
    <div class="showcase-stage">
      <aside class="story" aria-live="polite"><div class="story-track" id="story-track"><div class="story-panel is-current"><h2>代码全开源<br>隐私可审查</h2><p>完整代码和仓库公开可查。ClipClop 无需账号，没有云同步或遥测；除可关闭的更新检查外，核心功能均在本机离线运行。</p></div></div></aside>
    <div class="app-frame"><div class="app-window">
      <header class="titlebar"><div class="brand"><span class="brand-mark" aria-hidden="true"></span><span>ClipClop</span></div></header>
      <section class="left" aria-label="Clipboard history"><div class="search"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input id="search" type="search" placeholder="Search clipboard…" autocomplete="off" aria-label="搜索剪贴板历史"><button class="filter-static" type="button" aria-label="筛选历史记录"><SlidersHorizontal size={14} aria-hidden="true" /><kbd aria-hidden="true">/</kbd></button></div><div class="clip-list" id="clip-list" role="listbox" tabindex="0" aria-label="Clipboard history"></div></section>
      <section class="preview" aria-label="Selected clipboard item preview" aria-live="polite"><div class="preview-body"><div class="preview-content" id="preview"></div></div><div class="preview-meta"><div class="meta-content" id="facts"></div></div></section>
      <footer class="pager"><button disabled aria-label="Previous page"><ArrowLeft size={16} aria-hidden="true" /></button><div class="page-scrubber" aria-hidden="true"><span class="page-ticks"><i></i><i></i><i></i><i></i><i></i></span></div><span class="page-count">1/1</span><button disabled aria-label="Next page"><ArrowRight size={16} aria-hidden="true" /></button></footer>
      <footer class="actions" aria-label="Preview-only actions"><span class="static-action" aria-disabled="true"><kbd>⌘ K</kbd> <span data-i18n="actions">Actions</span></span><span class="static-action primary-static" aria-disabled="true">↵ <span data-i18n="paste">Paste</span></span></footer>
    </div></div>
    </div><div id="steps" aria-hidden="true"></div>
  </section>
  <section class="home-section trust" aria-labelledby="trust-title"><h2 id="trust-title" data-i18n="trustTitle">Your clipboard history is yours to manage.</h2><p data-i18n="trustCopy">Clipboard history stays on your device and is not uploaded to the cloud. You choose how long to keep it and how many items to save, and you can delete individual entries or clear everything at any time. ClipClop is fully open source, so its data and network boundaries can be inspected.</p><nav class="text-links" aria-label="Trust details"><a href="https://github.com/hiQianFan/ClipClop" target="_blank" rel="noopener noreferrer" data-i18n="sourceLink">View source code</a><a href="/en/privacy" data-i18n="privacyLink">Read the privacy notice</a></nav></section>
  <section class="home-section closing" aria-labelledby="closing-title"><h2 id="closing-title" data-i18n="closingTitle">Keep everything you copy within reach.</h2><p data-i18n="closingCopy">Download ClipClop with no account required. Open your clipboard history with one shortcut.</p><div class="closing-actions"><a class="primary" href="/en/download"><Download size={18} aria-hidden="true"/><span data-i18n="download">Download ClipClop</span></a></div><small class="closing-note"><span id="release-context" data-i18n="releaseContext">For the current version and release history, see the</span> <a href="/en/changelog" data-i18n="changelogLink">full changelog</a></small></section>
</main>
<SiteFooter />
<script is:inline src="/scripts/index.js"></script></body></html>
