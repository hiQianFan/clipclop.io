  <link rel="canonical" href="https://clipclop.io/en/privacy">
  <link rel="alternate" hreflang="zh" href="https://clipclop.io/zh/privacy"><link rel="alternate" hreflang="en" href="https://clipclop.io/en/privacy"><link rel="alternate" hreflang="x-default" href="https://clipclop.io/en/privacy"><meta property="og:locale" content="en_US">
  <meta property="og:type" content="article"><meta property="og:site_name" content="ClipClop"><meta property="og:title" content="Privacy — ClipClop"><meta property="og:description" content="Learn how ClipClop stores clipboard history locally, when it accesses the network, and which deletion and permission controls are available."><meta property="og:url" content="https://clipclop.io/en/privacy"><meta property="og:image" content="https://clipclop.io/hero-logo.webp">
  <meta name="twitter:card" content="summary"><meta name="twitter:title" content="Privacy — ClipClop"><meta name="twitter:description" content="Learn how ClipClop stores clipboard history locally, when it accesses the network, and which deletion and permission controls are available."><meta name="twitter:image" content="https://clipclop.io/hero-logo.webp">
