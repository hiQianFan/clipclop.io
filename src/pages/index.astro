---
import { ArrowLeft, ArrowRight, Code2, Compass, Download, File, Folder, Image, MonitorSmartphone, SlidersHorizontal, SquareTerminal } from "@lucide/astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
const macDownload = "/download/macos";
const windowsDownload = "/download/windows";
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="description" content="ClipClop — 安静、快速、键盘优先的剪贴板历史。">
  <meta name="color-scheme" content="light dark"><meta name="theme-color" content="#17181a" media="(prefers-color-scheme: dark)"><meta name="theme-color" content="#f2f3f4" media="(prefers-color-scheme: light)">
  <title>ClipClop — Your clipboard, one shortcut away</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline>try{const theme=localStorage.getItem("clipclop-theme");if(theme==="light"||theme==="dark")document.documentElement.dataset.theme=theme}catch{}</script>
  <style is:global>
    :root{color-scheme:light dark;--site-max-width:1440px;--site-gutter:clamp(20px,4vw,64px);--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-hover:#fff;--action-on:#17181a;--danger:#ff6b72;--danger-fill:#b4232f;--danger-on:#fff;--success:#72d69a;--mono:ui-monospace,"SF Mono","Cascadia Code","JetBrains Mono",Consolas,monospace;--sans:-apple-system,BlinkMacSystemFont,"Segoe UI Variable","Segoe UI",system-ui,sans-serif;--fs-caption:11px;--fs-meta:12px;--fs-ui:13px;--fs-body:14px;--fs-emphasis:15px;--fs-heading:20px;--lh-flush:1;--lh-tight:1.3;--lh-snug:1.5;--lh-normal:1.6;--lh-relaxed:1.75;--radius-sm:4px;--radius-md:6px;--radius-lg:8px;--radius-xl:14px;--radius-pill:999px;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3);--menu-shadow:0 6px 8px rgb(0 0 0/.25);--dur-fast:140ms;--dur-mid:160ms;--dur-slow:250ms;--ease-out:cubic-bezier(.16,1,.3,1)}
    @media(prefers-color-scheme:light){:root{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-hover:#34383c;--action-on:#fff;--danger:#b4232f;--danger-fill:#b4232f;--success:#18794e;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2);--menu-shadow:0 6px 8px rgb(24 28 32/.18)}}
    :root[data-theme=dark]{--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-hover:#fff;--action-on:#17181a;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3)}:root[data-theme=light]{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-hover:#34383c;--action-on:#fff;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2)}
    :root[data-theme=dark]{--danger:#ff6b72;--danger-fill:#b4232f;--success:#72d69a;--menu-shadow:0 6px 8px rgb(0 0 0/.25)}:root[data-theme=light]{--danger:#b4232f;--danger-fill:#b4232f;--success:#18794e;--menu-shadow:0 6px 8px rgb(24 28 32/.18)}
    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:76px}body{margin:0;color:var(--text-1);background:var(--bg-shell);font-family:var(--sans);-webkit-font-smoothing:antialiased}button,input,a{font:inherit}a{color:inherit}:focus-visible{outline:2px solid var(--text-1);outline-offset:3px}
    .hero{min-height:100svh;display:grid;place-items:center;position:relative;padding:96px var(--site-gutter) clamp(120px,18svh,220px)}.hero-inner{display:grid;align-items:center}.hero-copy{text-align:left}.logo{height:auto;justify-self:center}h1{margin:0;font-size:clamp(4rem,10vw,6rem);line-height:.95;letter-spacing:-.04em;text-wrap:balance}.hero-shortcuts{display:flex;align-items:center;gap:16px;margin-top:36px;opacity:.72}.shortcut-hint{display:flex;align-items:center;gap:6px;color:var(--text-2);font-size:13px;font-weight:500}.shortcut-hint kbd{min-width:28px;padding:4px 7px;border:1px solid var(--hairline);border-radius:var(--radius-sm);color:var(--text-2);background:var(--bg-raised);font:600 12px/1 var(--sans);text-align:center}.tagline{max-width:580px;margin:12px 0 36px;color:var(--text-2);font-size:clamp(1.05rem,2vw,1.35rem);line-height:1.55;text-wrap:pretty}.hero-actions{display:flex;flex-wrap:wrap}.primary{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:0 22px;border-radius:var(--radius-md);color:var(--action-on);background:var(--action);text-decoration:none;font-weight:650;transition:background var(--dur-fast) var(--ease-out)}.primary:hover{background:var(--action-hover)}
    .showcase{min-height:620vh;position:relative;padding-inline:var(--site-gutter)}.showcase-stage{width:min(var(--site-max-width),calc(100vw - 2 * var(--site-gutter)));height:calc(100svh - 76px);min-height:540px;position:sticky;top:76px;margin:0 auto;display:grid;grid-template-columns:minmax(300px,360px) minmax(0,1040px);justify-content:center;align-items:center;gap:40px}.story{min-height:220px;align-self:center;display:flex;flex-direction:column;justify-content:center}.story h2{margin:0;color:var(--text-1);font-size:clamp(2.75rem,3.3vw,3.75rem);line-height:1.06;letter-spacing:-.03em;white-space:pre-line}.story p{max-width:34ch;margin:22px 0 0;color:var(--text-2);font-size:18px;line-height:1.7;text-wrap:pretty}.app-frame{width:100%;height:var(--app-height,585px);position:relative;transform:translateY(var(--app-intro-offset,0))}.app-window{width:1040px;height:585px;position:absolute;top:0;right:0;display:grid;grid-template:42px minmax(0,1fr) 48px/320px minmax(0,1fr);overflow:hidden;border:1px solid var(--hairline);border-radius:var(--radius-xl);background:var(--bg-shell);box-shadow:var(--panel-shadow);transform:translateX(var(--app-intro-x,0)) scale(var(--app-scale,1));transform-origin:top right}.titlebar{grid-column:1/-1;display:flex;align-items:center;padding:0 14px;border-bottom:1px solid var(--hairline);user-select:none}.brand{height:30px;display:flex;align-items:center;gap:5px;padding:0 8px;color:var(--text-2);font-size:12px;font-weight:600;letter-spacing:.01em}.brand-mark{width:14px;height:14px;flex:none;background:currentColor;mask:url('/clipclop-mark.svg') center/contain no-repeat;-webkit-mask:url('/clipclop-mark.svg') center/contain no-repeat}
    .story{height:100%;align-self:stretch;display:block;overflow:hidden}.story-track{height:1000%;transform:translate3d(0,var(--story-offset,0),0)}.story-panel{height:10%;display:flex;flex-direction:column;justify-content:center}
    #steps::after{height:35vh;display:block;content:""}
    .left{min-height:0;display:flex;flex-direction:column;border-right:1px solid var(--hairline)}.search{height:42px;flex:none;display:flex;align-items:center;gap:8px;padding:0 14px;color:var(--text-3);border-bottom:1px solid var(--hairline)}.search>svg{width:15px;height:15px;flex:none}.search input{min-width:0;flex:1;border:0;outline:0;padding:0;color:var(--text-1);background:transparent;font:var(--fs-body)/var(--lh-normal) var(--mono)}.search input::placeholder{color:var(--text-2);opacity:1}.filter-static{min-width:30px;height:28px;flex:none;display:flex;align-items:center;justify-content:center;gap:4px;padding:0 5px;border:0;border-radius:var(--radius-sm);color:var(--text-2);background:transparent}.filter-static:hover{color:var(--text-1);background:var(--bg-hover)}.filter-static svg{width:14px;height:14px}.filter-static kbd{min-width:0;display:inline-flex;align-items:center;padding:1px 5px;border:1px solid var(--hairline);border-radius:var(--radius-sm);color:var(--text-2);background:transparent;font:500 var(--fs-caption)/var(--lh-snug) var(--sans);white-space:nowrap}kbd{min-width:24px;padding:3px 6px;border:1px solid var(--hairline);border-radius:var(--radius-sm);color:var(--text-2);background:var(--bg-shell);font:var(--fs-caption)/var(--lh-flush) var(--sans);text-align:center}
    .clip-list{flex:1;min-height:0;display:flex;flex-direction:column;gap:1px;padding:6px;overflow:hidden;outline:0}.clip-row,.list-slot{flex:1 0 44px}.clip-row{width:100%;min-height:44px;display:flex;align-items:center;gap:8px;padding:7px 8px;border:0;border-radius:var(--radius-lg);color:var(--text-1);background:transparent;text-align:left;cursor:default;transition:background var(--dur-fast) var(--ease-out)}.clip-row:hover{background:var(--bg-hover)}.clip-row[aria-selected=true]{background:color-mix(in srgb,var(--bg-selected) 55%,transparent)}.clip-list:focus .clip-row[aria-selected=true]{background:var(--bg-selected)}.clip-row:focus-visible{outline:2px solid var(--text-2);outline-offset:-2px}.num{width:16px;flex:none;color:var(--text-3);font-size:var(--fs-ui);font-weight:650;line-height:var(--lh-flush);font-variant-numeric:tabular-nums lining-nums;text-align:center}.lead{width:28px;height:28px;flex:none;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-sm);color:var(--text-2)}.lead.media{overflow:hidden;background:var(--bg-raised)}.lead.color{color:transparent;border:1px solid var(--hairline)}.lead img{width:100%;height:100%;object-fit:cover}.snippet{min-width:0;flex:1;overflow:hidden;color:var(--text-1);font:var(--fs-body)/var(--lh-normal) var(--mono);text-overflow:ellipsis;white-space:nowrap}.empty{margin:auto;color:var(--text-2);font-size:var(--fs-ui)}
    .preview{min-width:0;min-height:0;display:flex;flex-direction:column}.preview-body{min-height:0;flex:1;display:flex;align-items:flex-start;padding:20px;overflow:auto}.preview-content{width:100%;height:100%;animation:preview-in var(--dur-fast) var(--ease-out)}.preview-text,.file-path{margin:0;color:var(--text-1);font:13px/1.65 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere}.file-path{color:var(--text-2)}.color-preview{height:100%;display:flex;align-items:center;justify-content:center;gap:14px}.color-swatch{width:72px;height:72px;border:1px solid var(--hairline);border-radius:var(--radius-lg)}.image-preview{width:100%;height:100%;min-height:180px;display:flex;align-items:center;justify-content:center}.image-preview img{display:block;max-width:100%;max-height:100%;object-fit:contain;border-radius:var(--radius-lg)}.preview-meta{height:72px;flex:none;display:flex;align-items:center;padding:8px 20px;border-top:1px solid var(--hairline);color:var(--text-2)}.meta-mark{display:none}.meta-content{min-width:0;width:100%}.meta-summary{min-width:0;width:100%;display:grid;grid-template-columns:minmax(0,1fr) 220px;align-items:center;gap:20px}.meta-source{min-width:0;display:flex;align-items:center;gap:8px}.source-details{min-width:0;display:flex;flex-direction:column;gap:2px;color:var(--text-2);font:12px/1.2 var(--mono)}.source-details span,.source-details time{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-details time{color:var(--text-3);font-size:10px}.source-icon{width:22px;height:22px;flex:none;display:grid;place-items:center;border-radius:var(--radius-sm);color:var(--text-2);overflow:hidden}.source-icon img{width:22px;height:22px;object-fit:contain}.source-icon svg{width:18px;height:18px}:root[data-theme=dark] .source-icon-codex img{filter:invert(1)}.meta-facts{min-width:0;width:220px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:0}.meta-facts div{min-width:0;display:flex;flex-direction:column;align-items:flex-end;gap:3px;white-space:nowrap}.meta-facts dt,.meta-facts dd{max-width:100%;overflow:hidden;text-overflow:ellipsis}.meta-facts dt{color:var(--text-3);font:10px/1 var(--mono)}.meta-facts dd{margin:0;color:var(--text-2);font:11px/1.2 var(--mono);font-variant-numeric:tabular-nums}.explore{display:none}
    .pager,.actions{display:flex;align-items:center;border-top:1px solid var(--hairline)}.pager{display:grid;grid-template-columns:36px minmax(70px,1fr) auto 36px;align-items:center;gap:16px;padding:0 14px;border-right:1px solid var(--hairline);color:var(--text-2);font:var(--fs-ui) var(--mono)}.page-count{min-width:34px;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}.pager button{width:36px;height:30px;display:grid;place-items:center;padding:0;border:1px solid var(--hairline);border-radius:var(--radius-sm);color:var(--text-2);background:transparent}.pager button:disabled{color:var(--text-3);opacity:.35}.page-scrubber{height:30px;min-width:70px;position:relative;overflow:hidden;border-radius:var(--radius-sm);opacity:.35}.page-ticks{position:absolute;inset:0}.page-ticks i{width:2px;position:absolute;left:50%;top:50%;margin-left:-1px;border-radius:var(--radius-pill);background:var(--text-2);transform:translate(-50%,-50%)}.page-ticks i:nth-child(1){height:9px;transform:translate(-36px,-50%);opacity:.4}.page-ticks i:nth-child(2){height:12px;transform:translate(-18px,-50%);opacity:.65}.page-ticks i:nth-child(3){height:16px}.page-ticks i:nth-child(4){height:12px;transform:translate(18px,-50%);opacity:.65}.page-ticks i:nth-child(5){height:9px;transform:translate(36px,-50%);opacity:.4}.actions{justify-content:flex-end;gap:12px;padding:0 16px}.static-action{min-height:32px;display:flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid var(--hairline);border-radius:var(--radius-md);color:var(--text-2);opacity:.72;user-select:none;font-size:var(--fs-meta)}.static-action.primary-static{border:0;padding-inline:15px;color:var(--action-on);background:var(--action);opacity:.8;font-weight:650}.scroll-step{height:100vh;pointer-events:none}
    .brand{font-size:var(--fs-ui)}.preview-text,.file-path{font:var(--fs-body)/var(--lh-relaxed) var(--mono)}.source-details{font:var(--fs-ui)/var(--lh-tight) var(--mono)}.source-details time,.meta-facts dt{font-size:var(--fs-caption);line-height:var(--lh-flush)}.meta-facts dd{font:var(--fs-meta)/var(--lh-tight) var(--mono)}.scroll-step{height:70vh}
    .home-section{width:min(1040px,calc(100vw - 2 * var(--site-gutter)));margin:0 auto;padding:112px 0;border-top:1px solid var(--hairline)}.home-section h2{max-width:760px;margin:0;font-size:clamp(2.4rem,6vw,4.5rem);line-height:1.05;letter-spacing:-.04em;text-wrap:balance}.home-section p{max-width:720px;margin:24px 0 0;color:var(--text-2);font-size:17px;line-height:1.75;text-wrap:pretty}.text-links{display:flex;flex-wrap:wrap;gap:20px;margin-top:28px}.text-links a{color:var(--text-1);font:600 13px var(--mono);text-underline-offset:5px}.closing{text-align:center}.closing h2,.closing p{margin-inline:auto}.closing-actions{display:flex;justify-content:center;margin:36px auto 0}.closing-note{display:block;margin-top:22px;color:var(--text-2);font:12px var(--mono)}.closing-note a{text-underline-offset:4px}
    @keyframes preview-in{from{opacity:.35;transform:translateY(5px)}}
    @media(max-width:1100px) and (min-width:769px){.story h2{font-size:40px}.story p{font-size:17px}}
    @media(max-width:768px){.hero-inner,.hero-copy{display:flex;flex-direction:column;align-items:center;text-align:center}.hero-shortcuts{justify-content:center}.showcase{margin-top:calc(-1 * var(--mobile-showcase-overlap,0px));padding-inline:10px;padding-bottom:var(--mobile-showcase-overlap,0px)}.showcase-stage{width:100%;height:calc(100svh - 70px);min-height:620px;top:70px;grid-template:minmax(0,1fr) auto/1fr;gap:28px}.story{min-height:96px;grid-row:2;padding:0 10px max(8px,env(safe-area-inset-bottom))}.story h2{max-width:none;font-size:32px;line-height:1.1;letter-spacing:-.03em}.story p{max-width:60ch;margin-top:12px;font-size:16px;line-height:1.65}.scroll-step{height:70vh}}
    @media(max-width:768px){.story{height:auto;overflow:visible}.story-track{height:auto;transform:none!important;transition:none}.story-panel{height:auto;display:none}.story-panel.is-current{display:flex}}
    @media(max-width:768px){#steps::after{height:0}}
    @media(max-width:420px){.filter-static svg,.actions .static-action:first-child{display:none}.preview-meta{gap:10px}.fact{font-size:10px}}
    @media(max-width:680px){.home-section{padding-block:80px}}
    @media(prefers-color-scheme:dark){:root:not([data-theme=light]) body{background:var(--bg-raised)}:root:not([data-theme=light]) .source-icon-codex img{filter:invert(1)}}
    :root[data-theme=dark] body{background:var(--bg-raised)}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.app-frame{transform:none!important}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
  </style>
  <style is:global>
    .hero-inner{width:min(1240px,100%);grid-template-columns:minmax(0,1fr) minmax(400px,560px);column-gap:clamp(48px,5vw,80px);row-gap:clamp(20px,2.5vh,32px)}.hero-copy{grid-column:1}.logo{width:min(100%,520px);position:relative;z-index:1;grid-column:2;grid-row:1/3}.hero-actions{width:min(100%,520px);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-column:1;grid-row:2;gap:12px}.tagline{margin-bottom:0}#hero-title{width:max-content;position:relative;font-size:clamp(5.5rem,7vw,7rem)}#hero-title::after{z-index:1;width:190px;height:190px;position:absolute;top:-70px;right:-28px;background:var(--text-1);content:"";opacity:.38;transform:rotate(16deg);mask:url('/clipclop-mark.svg') center/contain no-repeat;-webkit-mask:url('/clipclop-mark.svg') center/contain no-repeat}.platform-download{white-space:nowrap}.platform-download svg{width:18px;height:18px;flex:none}.secondary-download{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:0 22px;border:1px solid var(--hairline);border-radius:var(--radius-md);color:var(--text-1);background:var(--bg-raised);text-decoration:none;font-weight:650}.secondary-download:hover{background:var(--bg-hover)}
    @media(max-width:1100px){html,body{overflow-x:clip}.hero-copy{align-self:center}.logo{grid-row:1}.hero-actions{display:none}}
    @media(max-width:768px){.hero{place-items:start center;padding-block:clamp(104px,13svh,128px) clamp(48px,6svh,72px)}.showcase-stage{min-width:0;min-height:0;grid-template:auto auto/1fr;align-content:start;justify-content:stretch}.hero-inner{gap:clamp(16px,3vmin,28px)}.hero-copy{order:1}.logo{width:clamp(160px,48vw,220px);order:2;margin:0}.hero-shortcuts{margin-top:24px}.tagline{margin:10px 0 0}#hero-title{font-size:clamp(3.75rem,17vw,5rem)}#hero-title::after{width:112px;height:112px;top:-40px;right:-15px}.app-frame{min-width:0;display:block;overflow:visible}.app-window{left:0;right:auto;transform-origin:top left}}
  </style>
</head>
<body>
<template id="icon-browser"><Compass size={15} strokeWidth={1.8} /></template>
<template id="icon-folder"><Folder size={15} strokeWidth={1.8} /></template>
<template id="icon-image"><Image size={15} strokeWidth={1.8} /></template>
<template id="icon-terminal"><SquareTerminal size={15} strokeWidth={1.8} /></template>
<template id="icon-code"><Code2 size={15} strokeWidth={1.8} /></template>
<template id="icon-device"><MonitorSmartphone size={15} strokeWidth={1.8} /></template>
<template id="icon-file"><File size={18} strokeWidth={1.7} /></template>
<SiteHeader current="home" />
<main>
  <section class="hero" id="home" aria-labelledby="hero-title"><div class="hero-inner">
    <div class="hero-copy"><h1 id="hero-title">ClipClop</h1><div class="hero-shortcuts" data-i18n-group="shortcuts"><span class="shortcut-hint"><kbd>⌃⌘C</kbd> <span data-i18n="shortcut-open">呼出</span></span><span class="shortcut-hint"><kbd>↵</kbd> <span data-i18n="shortcut-paste">粘贴</span></span></div><p class="tagline" data-i18n="tagline">马不停贴，哒哒两步，快速粘贴。<br>复制过的内容，本地永久保存，永不丢失。</p></div>
