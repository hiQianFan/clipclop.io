---
import { Code2, Compass, File, Folder, Image, MonitorSmartphone, SquareTerminal } from "@lucide/astro";
import SiteHeader from "../components/SiteHeader.astro";
const releaseUrl = "https://github.com/hiQianFan/ClipClop/releases/latest";
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="description" content="ClipClop — 安静、快速、键盘优先的剪贴板历史。">
  <meta name="color-scheme" content="light dark"><meta name="theme-color" content="#17181a" media="(prefers-color-scheme: dark)"><meta name="theme-color" content="#f2f3f4" media="(prefers-color-scheme: light)">
  <title>ClipClop — Your clipboard, one shortcut away</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline>try{const theme=localStorage.getItem("clipclop-theme");if(theme==="light"||theme==="dark")document.documentElement.dataset.theme=theme}catch{}</script>
  <style is:global>
    :root{color-scheme:light dark;--site-max-width:1440px;--site-gutter:clamp(20px,4vw,64px);--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-hover:#fff;--action-on:#17181a;--mono:"SF Mono","Cascadia Mono",ui-monospace,Menlo,monospace;--sans:-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;--radius-sm:4px;--radius-md:6px;--radius-lg:8px;--radius-xl:14px;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3);--dur-fast:140ms;--ease-out:cubic-bezier(.16,1,.3,1)}
    @media(prefers-color-scheme:light){:root{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-hover:#34383c;--action-on:#fff;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2)}}
    :root[data-theme=dark]{--bg-shell:#17181a;--bg-raised:#1e2022;--bg-hover:#242628;--bg-selected:#2a2d30;--hairline:#2c2f32;--text-1:#ecedee;--text-2:#aeb3b7;--text-3:#8a9095;--action:#eceef0;--action-hover:#fff;--action-on:#17181a;--panel-shadow:0 2px 5px rgb(0 0 0/.18),0 12px 24px rgb(0 0 0/.3)}:root[data-theme=light]{--bg-shell:#f2f3f4;--bg-raised:#fafbfb;--bg-hover:#eceeef;--bg-selected:#e2e5e8;--hairline:#d9dde0;--text-1:#1c1e20;--text-2:#5d6367;--text-3:#687076;--action:#1c1e20;--action-hover:#34383c;--action-on:#fff;--panel-shadow:0 2px 5px rgb(24 28 32/.1),0 12px 24px rgb(24 28 32/.2)}
    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:76px}body{margin:0;color:var(--text-1);background:var(--bg-shell);font-family:var(--sans);-webkit-font-smoothing:antialiased}button,input,a{font:inherit}a{color:inherit}:focus-visible{outline:2px solid var(--text-1);outline-offset:3px}
    .hero{min-height:100svh;display:grid;place-items:center;position:relative;padding:96px var(--site-gutter) clamp(120px,18svh,220px)}.hero-inner{display:grid;align-items:center}.hero-copy{text-align:left}.logo{height:auto;justify-self:center}h1{margin:0;font-size:clamp(4rem,10vw,6rem);line-height:.95;letter-spacing:-.04em;text-wrap:balance}.tagline{max-width:580px;margin:24px 0 36px;color:var(--text-2);font-size:clamp(1.05rem,2vw,1.35rem);line-height:1.55;text-wrap:pretty}.hero-actions{display:flex;flex-wrap:wrap}.primary{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:0 22px;border-radius:var(--radius-md);color:var(--action-on);background:var(--action);text-decoration:none;font-weight:650;transition:background var(--dur-fast) var(--ease-out)}.primary:hover{background:var(--action-hover)}
    .showcase{min-height:620vh;position:relative;padding-inline:var(--site-gutter)}.showcase-stage{width:min(var(--site-max-width),calc(100vw - 2 * var(--site-gutter)));height:calc(100svh - 76px);min-height:540px;position:sticky;top:76px;margin:0 auto;display:grid;grid-template-columns:minmax(300px,360px) minmax(0,1040px);justify-content:center;align-items:center;gap:40px}.story{min-height:220px;align-self:center;display:flex;flex-direction:column;justify-content:center}.story h2{margin:0;color:var(--text-1);font-size:clamp(2rem,2.2vw,2.75rem);line-height:1.08;letter-spacing:-.03em;white-space:pre-line}.story p{max-width:35ch;margin:20px 0 0;color:var(--text-2);font-size:16px;line-height:1.65;text-wrap:pretty}.app-frame{width:100%;height:var(--app-height,585px);position:relative;transform:translateY(var(--app-intro-offset,0))}.app-window{width:1040px;height:585px;position:absolute;top:0;right:0;display:grid;grid-template:42px minmax(0,1fr) 48px/320px minmax(0,1fr);overflow:hidden;border-radius:var(--radius-xl);background:var(--bg-shell);box-shadow:var(--panel-shadow);transform:translateX(var(--app-intro-x,0)) scale(var(--app-scale,1));transform-origin:top right}.titlebar{grid-column:1/-1;display:flex;align-items:center;padding:0 14px;border-bottom:1px solid var(--hairline);user-select:none}.brand{height:30px;display:flex;align-items:center;gap:5px;padding:0 8px;color:var(--text-2);font-size:12px;font-weight:600;letter-spacing:.01em}.brand-mark{width:14px;height:14px;flex:none;background:currentColor;mask:url('/clipclop-mark.svg') center/contain no-repeat;-webkit-mask:url('/clipclop-mark.svg') center/contain no-repeat}
    .left{min-height:0;display:flex;flex-direction:column;border-right:1px solid var(--hairline)}.search{height:42px;flex:none;display:flex;align-items:center;gap:8px;padding:0 14px;color:var(--text-3);border-bottom:1px solid var(--hairline)}.search svg{width:15px;height:15px}.search input{min-width:0;flex:1;border:0;outline:0;color:var(--text-1);background:transparent;font-size:13px}.search input::placeholder{color:var(--text-2);opacity:1}.filter-static{display:flex;align-items:center;gap:4px;color:var(--text-2)}kbd{min-width:24px;padding:3px 6px;border:1px solid var(--hairline);border-radius:var(--radius-sm);color:var(--text-2);background:var(--bg-shell);font:10px/1 var(--mono);text-align:center}
    .clip-list{flex:1;min-height:0;display:flex;flex-direction:column;gap:1px;padding:6px;overflow:hidden;outline:0}.clip-row{width:100%;height:44px;flex:0 0 44px;display:flex;align-items:center;gap:8px;padding:7px 8px;border:0;border-radius:var(--radius-lg);color:var(--text-1);background:transparent;text-align:left;cursor:default;transition:background var(--dur-fast) var(--ease-out)}.clip-row:hover{background:var(--bg-hover)}.clip-row[aria-selected=true]{background:var(--bg-selected)}.clip-row:focus-visible{outline:2px solid var(--text-2);outline-offset:-2px}.num{width:16px;flex:none;color:var(--text-3);font-size:12px;font-weight:650;text-align:center}.lead{width:28px;height:28px;flex:none;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:var(--radius-sm);color:var(--text-2);background:var(--bg-raised)}.lead:empty{display:none}.lead.color{border:1px solid var(--hairline)}.lead img{width:100%;height:100%;object-fit:cover}.snippet{min-width:0;flex:1;overflow:hidden;color:var(--text-1);font:13px/1.5 var(--mono);text-overflow:ellipsis;white-space:nowrap}.empty{margin:auto;color:var(--text-2);font-size:13px}
    .preview{min-width:0;min-height:0;display:flex;flex-direction:column}.preview-body{min-height:0;flex:1;display:flex;align-items:flex-start;padding:20px;overflow:auto}.preview-content{width:100%;height:100%;animation:preview-in var(--dur-fast) var(--ease-out)}.preview-text{margin:0;color:var(--text-1);font:13px/1.65 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere}.color-preview{height:100%;display:flex;align-items:center;justify-content:center;gap:14px}.color-swatch{width:72px;height:72px;border:1px solid var(--hairline);border-radius:var(--radius-lg)}.image-preview{height:100%;min-height:180px;display:grid;place-items:center;overflow:hidden}.image-preview img{display:block;max-width:100%;max-height:100%;object-fit:contain;border-radius:var(--radius-lg)}.file-preview{height:100%;display:grid;place-items:center;color:var(--text-3);font-size:12px}.file-preview svg{margin-bottom:10px}.file-preview span{display:flex;flex-direction:column;align-items:center}.preview-meta{height:64px;flex:none;display:flex;align-items:center;padding:8px 20px;border-top:1px solid var(--hairline);color:var(--text-2)}.preview.file-preview-active .preview-meta{height:96px;display:grid;grid-template-rows:minmax(0,1fr) auto;gap:7px;padding-block:10px}.meta-mark{display:none}.meta-content{min-width:0;width:100%}.meta-file{min-width:0;width:100%;display:flex;flex-direction:column;gap:3px;color:var(--text-2);font:11px/1.4 var(--mono)}.meta-file span,.meta-file code{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.meta-file code{color:var(--text-3);font-size:10px}.meta-summary{min-width:0;width:100%;display:grid;grid-template-columns:minmax(0,1fr) 200px;align-items:center;gap:20px}.meta-source{min-width:0;display:flex;align-items:center;gap:8px}.source-details{min-width:0;display:flex;flex-direction:column;gap:2px;color:var(--text-2);font:12px/1.2 var(--mono)}.source-details span,.source-details time{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.source-details time{color:var(--text-3);font-size:10px}.source-icon{width:22px;height:22px;flex:none;display:grid;place-items:center;border-radius:var(--radius-sm);color:var(--text-2);overflow:hidden}.source-icon img{width:22px;height:22px;object-fit:contain}.source-icon svg{width:18px;height:18px}.meta-facts{min-width:0;width:200px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:0}.meta-facts div{min-width:0;display:flex;flex-direction:column;align-items:flex-end;gap:2px;white-space:nowrap}.meta-facts dt,.meta-facts dd{max-width:100%;overflow:hidden;text-overflow:ellipsis}.meta-facts dt{color:var(--text-3);font:10px/1 var(--mono)}.meta-facts dd{margin:0;color:var(--text-2);font:11px/1.2 var(--mono);font-variant-numeric:tabular-nums}.explore{display:none}
    .pager,.actions{display:flex;align-items:center;border-top:1px solid var(--hairline)}.pager{display:grid;grid-template-columns:36px minmax(70px,1fr) auto 36px;gap:16px;padding:0 14px;border-right:1px solid var(--hairline);color:var(--text-2);font:12px var(--mono)}.pager span{text-align:right}.pager button{width:36px;height:30px;display:grid;place-items:center;border:1px solid var(--hairline);border-radius:var(--radius-sm);color:var(--text-2);background:transparent}.pager button:disabled{opacity:.35}.actions{justify-content:flex-end;gap:12px;padding:0 16px}.static-action{min-height:32px;display:flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid var(--hairline);border-radius:var(--radius-md);color:var(--text-2);opacity:.72;user-select:none;font-size:12px}.static-action.primary-static{border:0;padding-inline:15px;color:var(--action-on);background:var(--action);opacity:.8;font-weight:650}.scroll-step{height:100vh;pointer-events:none}
    .changelog{width:min(var(--site-max-width),calc(100vw - 2 * var(--site-gutter)));margin:0 auto;padding:128px 0 112px}.changelog-head{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:32px;margin-bottom:52px}.changelog h2{margin:0 0 14px;font-size:clamp(2.8rem,7vw,5rem);line-height:1;letter-spacing:-.04em}.changelog-head p{max-width:580px;margin:0;color:var(--text-2);font-size:17px;line-height:1.65}.changelog-link{min-height:40px;display:flex;align-items:center;padding:0 13px;border:1px solid var(--hairline);border-radius:var(--radius-md);color:var(--text-2);text-decoration:none;font:12px var(--mono)}.changelog-link:hover{color:var(--text-1);background:var(--bg-hover)}.release-status{padding:30px 0;color:var(--text-2);font:13px var(--mono)}.release-entry{display:grid;grid-template-columns:180px minmax(0,760px);gap:48px;padding:34px 0;border-top:1px solid var(--hairline)}.release-version{font:12px var(--mono)}.release-version strong{display:block;margin-bottom:8px;color:var(--text-1);font-size:16px}.release-version time{color:var(--text-3)}.release-latest{display:inline-block;margin-top:11px;padding:4px 7px;border-radius:var(--radius-sm);color:var(--action-on);background:var(--action);font-size:10px;font-weight:700}.release-body h3{margin:0 0 16px;font-size:24px}.release-notes{max-width:70ch;color:var(--text-2);font-size:14px;line-height:1.7;white-space:pre-wrap}.release-downloads{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}.release-downloads a{min-height:38px;display:inline-flex;align-items:center;padding:0 11px;border-radius:var(--radius-md);color:var(--text-1);background:var(--bg-selected);font:11px var(--mono);text-decoration:none}
    @keyframes preview-in{from{opacity:.35;transform:translateY(5px)}}
    @media(max-width:768px){.hero-inner,.hero-copy{display:flex;flex-direction:column;align-items:center;text-align:center}.showcase{padding-inline:10px}.showcase-stage{width:100%;height:calc(100svh - 70px);min-height:620px;top:70px;grid-template:minmax(0,1fr) auto/1fr;gap:16px}.story{min-height:96px;grid-row:2;padding:0 8px max(8px,env(safe-area-inset-bottom))}.story h2{max-width:none;font-size:20px}.story p{max-width:60ch;margin-top:8px;font-size:13px}.scroll-step{height:90vh}}
    @media(max-width:420px){.filter-static svg,.actions .static-action:first-child{display:none}.preview-meta{gap:10px}.fact{font-size:10px}}
    @media(max-width:680px){.changelog{padding-block:88px}.changelog-head,.release-entry{grid-template-columns:1fr}.release-entry{gap:18px}.changelog-link{width:max-content}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.app-frame{transform:none!important}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
  </style>
  <style is:global>
    .hero-inner{width:min(1240px,100%);grid-template-columns:minmax(0,1fr) minmax(400px,560px);column-gap:clamp(48px,5vw,80px);row-gap:clamp(20px,2.5vh,32px)}.hero-copy{grid-column:1}.logo{width:min(100%,520px);position:relative;z-index:1;grid-column:2;grid-row:1/3}.hero-actions{width:min(100%,440px);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-column:1;grid-row:2;gap:12px}.tagline{margin-bottom:0}#hero-title{width:max-content;position:relative;font-size:clamp(5.5rem,7vw,7rem)}#hero-title::after{z-index:1;width:190px;height:190px;position:absolute;top:-70px;right:-28px;background:var(--text-1);content:"";opacity:.38;transform:rotate(16deg);mask:url('/clipclop-mark.svg') center/contain no-repeat;-webkit-mask:url('/clipclop-mark.svg') center/contain no-repeat}.platform-download svg{width:18px;height:18px;flex:none}.secondary-download{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:0 22px;border:1px solid var(--hairline);border-radius:var(--radius-md);color:var(--text-1);background:var(--bg-raised);text-decoration:none;font-weight:650}.secondary-download:hover{background:var(--bg-hover)}
    @media(max-width:1100px){html,body{overflow-x:clip}.hero-copy{align-self:center}.logo{grid-row:1}.hero-actions{display:none}}
    @media(max-width:768px){.hero{place-items:start center;padding-block:clamp(104px,13svh,128px) clamp(48px,6svh,72px)}.showcase-stage{min-width:0;min-height:0;grid-template:auto auto/1fr;align-content:start;justify-content:stretch}.hero-inner{gap:clamp(16px,3vmin,28px)}.hero-copy{order:1}.logo{width:clamp(160px,48vw,220px);order:2;margin:0}.tagline{margin:clamp(10px,2vmin,16px) 0 0}#hero-title{font-size:clamp(3.75rem,17vw,5rem)}#hero-title::after{width:112px;height:112px;top:-40px;right:-15px}.app-frame{min-width:0;display:block;overflow:visible}.app-window{left:0;right:auto;transform-origin:top left}}
  </style>
</head>
<body>
<template id="icon-browser"><Compass size={15} strokeWidth={1.8} /></template>
<template id="icon-folder"><Folder size={15} strokeWidth={1.8} /></template>
<template id="icon-image"><Image size={15} strokeWidth={1.8} /></template>
<template id="icon-terminal"><SquareTerminal size={15} strokeWidth={1.8} /></template>
<template id="icon-code"><Code2 size={15} strokeWidth={1.8} /></template>
<template id="icon-device"><MonitorSmartphone size={15} strokeWidth={1.8} /></template>
<template id="icon-file"><File size={18} strokeWidth={1.7} /></template>
<SiteHeader current="home" />
<main>
  <section class="hero" id="home" aria-labelledby="hero-title"><div class="hero-inner">
    <div class="hero-copy"><h1 id="hero-title">ClipClop</h1><p class="tagline" data-i18n="tagline">你的剪贴板历史，始终只差一个快捷键。<br>快速、私密、键盘优先。</p></div>
    <div class="hero-actions"><a class="primary platform-download" href={releaseUrl} aria-label="Download ClipClop for macOS"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.7 13.5c0-2.4 2-3.6 2.1-3.7a4.5 4.5 0 0 0-3.5-1.9c-1.5-.2-2.9.9-3.7.9-.8 0-2-.9-3.3-.9a4.9 4.9 0 0 0-4.1 2.5c-1.8 3-.5 7.5 1.2 10 .9 1.2 1.8 2.5 3.2 2.4 1.3-.1 1.8-.8 3.4-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.2 3.1-2.4 1-1.4 1.4-2.8 1.4-2.9-.1 0-3.2-1.2-3.2-4M14.3 6.3A4.1 4.1 0 0 0 15.2 3a4.2 4.2 0 0 0-2.8 1.4 3.8 3.8 0 0 0-1 3 3.5 3.5 0 0 0 2.9-1.1"/></svg><span data-i18n="mac">下载 macOS 版</span></a><a class="secondary-download platform-download" href={releaseUrl} aria-label="Download ClipClop for Windows"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 5.3 10.6 4v7.3H3V5.3Zm8.5-1.5L21 2.4v8.9h-9.5V3.8ZM3 12.2h7.6v7.4L3 18.3v-6.1Zm8.5 0H21v9.4l-9.5-1.7v-7.7Z"/></svg><span data-i18n="windows">下载 Windows 版</span></a></div>
    <img class="logo" src="/hero-logo.webp" width="680" height="680" alt="ClipClop cow and horse app icon">
  </div></section>
  <section class="showcase" id="demo" aria-label="Interactive ClipClop preview">
    <div class="showcase-stage">
      <aside class="story" aria-live="polite"><h2 id="story-title">按你的选择<br>保留剪贴内容</h2><p id="story-copy">内容留在当前设备，不会同步到云端。你可以删除单条记录、清空历史，或限制历史的保留时间和数量。</p></aside>
    <div class="app-frame"><div class="app-window">
      <header class="titlebar"><div class="brand"><span class="brand-mark" aria-hidden="true"></span><span>ClipClop</span></div></header>
      <section class="left" aria-label="Clipboard history"><label class="search"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input id="search" type="search" placeholder="搜索剪贴板…" autocomplete="off" aria-label="搜索剪贴板历史"><span class="filter-static" aria-hidden="true">☷ <kbd>/</kbd></span></label><div class="clip-list" id="clip-list" role="listbox" tabindex="0" aria-label="Clipboard history"></div></section>
      <section class="preview" aria-label="Selected clipboard item preview" aria-live="polite"><div class="preview-body"><div class="preview-content" id="preview"></div></div><div class="preview-meta"><div class="meta-content" id="facts"></div></div></section>
      <footer class="pager"><button disabled aria-label="Previous page">←</button><span>1/1</span><button disabled aria-label="Next page">→</button></footer>
      <footer class="actions" aria-label="Preview-only actions"><span class="static-action" aria-disabled="true"><kbd>⌘ K</kbd> <span data-i18n="actions">操作</span></span><span class="static-action primary-static" aria-disabled="true">↵ <span data-i18n="paste">粘贴</span></span></footer>
    </div></div>
    </div><div id="steps" aria-hidden="true"></div>
  </section>
  <section class="changelog" id="changelog"><div class="changelog-head"><div><h2 data-i18n="changelogTitle">更新日志</h2><p data-i18n="changelogIntro">按版本查阅 ClipClop 的新增功能、改进和修复。内容直接来自 GitHub Releases。</p></div><a class="changelog-link" href="https://github.com/hiQianFan/ClipClop/releases" target="_blank" rel="noopener noreferrer" data-i18n="changelogSource">查看原始记录</a></div><div id="release-list" aria-live="polite"><p class="release-status" data-i18n="changelogLoading">正在读取更新日志…</p></div></section>
</main>
<script>
  const clipSets={
    zh:[
      {type:"text",text:"ClipClop 将受支持的剪贴内容保存在本机，不上传，也不用于内容分析。保留多久、保存多少，以及何时删除，都由你决定。",source:"Safari",icon:"browser",facts:[["字符","60"],["大小","162 B"]],title:"按你的选择\n保留剪贴内容",copy:"内容留在当前设备，不会同步到云端。你可以删除单条记录、清空历史，或限制历史的保留时间和数量。"},
