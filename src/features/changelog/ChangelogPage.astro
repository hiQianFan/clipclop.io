---
import LocalizedLayout from "../../layouts/LocalizedLayout.astro";
import PageHead from "../../components/PageHead.astro";
import type { Locale } from "../../i18n/config";
import { changelog } from "./i18n";
import "./changelog.css";
const { locale } = Astro.props as { locale: Locale };
const c = changelog[locale];
---
<LocalizedLayout locale={locale} page="changelog" title={c.title} description={c.description} ogTitle={c.ogTitle}>
  <main class="changelog">
    <PageHead title={c.heading} intro={c.intro}>
      <p slot="meta" class="hint" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd><span>{c.hint}</span></p>
      <div slot="aside" class="head-actions"><a class="download-page" href={`/${locale}/download`}>{c.download}</a><a class="source" href="https://github.com/hiQianFan/ClipClop/releases" target="_blank" rel="noopener noreferrer">{c.source}</a></div>
    </PageHead>
    <div id="release-list"><p class="status" role="status">{c.loading}</p></div>
  </main>
  <script id="changelog-data" type="application/json" set:html={JSON.stringify({ locale, latest: c.latest, none: c.none, noNotes: c.noNotes, error: c.error, versions: c.versions })}/>
  <script src="./changelog.ts"></script>
</LocalizedLayout>
