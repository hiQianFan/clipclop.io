---
import { Icon } from "astro-icon/components";
import LocalizedLayout from "../../layouts/LocalizedLayout.astro";
import type { Locale } from "../../i18n/config";
import { home } from "./i18n";
import "./home.css";
import monoGlyph from "./assets/mascot-mono.svg?raw";

const { locale } = Astro.props as { locale: Locale };
const c = home[locale];
const macDownload = "/download/macos", windowsDownload = "/download/windows";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ClipClop",
  description: c.description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "macOS, Windows",
  url: `https://clipclop.io/${locale}`,
  downloadUrl: `https://clipclop.io/${locale}/download`,
  image: "https://clipclop.io/hero-logo.webp",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
// Hero mascot layers: each style is the eyeless artwork plus SVG eyes in the artwork's own coordinates.
// eyes: [cx, cy, rx, ry, glint dx, glint dy, glint r]. Each viewBox is fitted so the four eyes land on the
// flat layout's eyes (least squares, ≤4px off), keeping the faces steady while the styles rotate.
const k = 2048 / 680;
const mascotLayers = [
  { style: "flat", viewBox: "0 140 1024 700", image: { href: "/mascot-flat.webp", x: 0, y: 140, width: 1024, height: 700 }, smile: 11,
    eyes: [[237.5, 566, 34.5, 41, -8, -17, 10.5], [424.5, 544.5, 34.5, 41, -9, -17, 10.5], [614.5, 534, 34.5, 41, -2.5, -19, 10.5], [806, 564.5, 34.5, 41, -2.5, -19, 10.5]] },
  { style: "clay", viewBox: "-60.9 218 2169.5 1483", image: { href: "/mascot-clay.webp", x: 0, y: 0, width: 2048, height: 2048 }, smile: 30,
    eyes: [[146, 376, 22, 28], [279, 359.5, 22, 28], [414, 346, 21.5, 27.5], [545, 368, 22.5, 28.5]].map(([x, y, rx, ry]) => [x * k, y * k, rx * k, ry * k, -8 * k, -11 * k, 7 * k]) },
  { style: "mono", viewBox: "-11 152.4 1050.9 718.4", glyph: monoGlyph, smile: 13,
    eyes: [[232.9, 586.3, 44, 48, 5, -18, 13], [428.2, 571.3, 46, 51, -8.5, -20, 13], [612.2, 555.8, 46, 52, 11, -21, 13], [819.8, 588.7, 46, 53, 1, -23, 13]] },
  // 64px grid drawn at 16 units per cell; eyes are 4x5 blocks given by their top-left cell.
  { style: "pixel", viewBox: "0 140 1024 700", image: { href: "/mascot-pixel.png", x: 0, y: 0, width: 1024, height: 1024 }, smile: 0, grid: 16, eyes: [],
    blocks: [[13, 33], [25, 32], [36, 31], [48, 33]] },
];
const cell = (x: number, y: number, w = 1, h = 1) => `M${x * 16} ${y * 16}h${w * 16}v${h * 16}h${-w * 16}z`;
---
<LocalizedLayout locale={locale} page="home" title={c.title} description={c.description} ogDescription={c.ogDescription}>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)}/>
<template id="icon-browser"><Icon name="lucide:compass" size={15} stroke-width="1.8" is:inline /></template>
<template id="icon-folder"><Icon name="lucide:folder" size={15} stroke-width="1.8" is:inline /></template>
<template id="icon-image"><Icon name="lucide:image" size={15} stroke-width="1.8" is:inline /></template>
<template id="icon-terminal"><Icon name="lucide:square-terminal" size={15} stroke-width="1.8" is:inline /></template>
<template id="icon-code"><Icon name="lucide:code-2" size={15} stroke-width="1.8" is:inline /></template>
<template id="icon-device"><Icon name="lucide:monitor-smartphone" size={15} stroke-width="1.8" is:inline /></template>
<template id="icon-file"><Icon name="lucide:file" size={18} stroke-width="1.7" is:inline /></template>
<template id="icon-star"><Icon name="lucide:star" size={14} stroke-width="1.8" is:inline /></template>
<main>
  <section class="hero" id="home" aria-labelledby="hero-title"><div class="hero-inner">
    <div class="hero-copy"><h1 id="hero-title">ClipClop<span class="hero-mark" aria-hidden="true"></span></h1><div class="hero-shortcuts"><span class="shortcut-hint"><kbd id="open-shortcut">⌃⌘C</kbd> <span>{c.open}</span></span><span class="shortcut-hint"><kbd>↵</kbd> <span>{c.paste}</span></span></div><p class="tagline">{c.tagline}<br>{c.tagline2}</p></div>
    <div class="hero-actions"><a class="primary platform-download" href={macDownload} aria-label="Download ClipClop for macOS"><Icon name="simple-icons:apple" size={18} aria-hidden="true"/><span>{c.mac}</span></a><a class="secondary-download platform-download" href={windowsDownload} aria-label="Download ClipClop for Windows"><Icon name="simple-icons:windows" size={18} aria-hidden="true"/><span>{c.windows}</span></a></div>
    <div class="logo mascot" data-style="flat" role="img" aria-label="ClipClop cow and horse mascot">{mascotLayers.map((layer) => (
      <svg class="mascot-layer" data-layer={layer.style} data-grid={layer.grid} viewBox={layer.viewBox} aria-hidden="true">
        {layer.image && <image href={layer.style === "flat" ? layer.image.href : undefined} data-href={layer.image.href} x={layer.image.x} y={layer.image.y} width={layer.image.width} height={layer.image.height}/>}
        {layer.glyph && <Fragment set:html={layer.glyph}/>}
        {layer.blocks?.map(([x, y], index) => <>
          <g class="eye"><path d={cell(x + 1, y, 2) + cell(x, y + 1, 4, 3) + cell(x + 1, y + 4, 2)}/><path class="glint" d={cell(x + 1, y + 1)}/></g>
          <path class={index ? "smile block" : "smile block on-patch"} d={cell(x, y + 3) + cell(x + 1, y + 2, 2) + cell(x + 3, y + 3)}/>
        </>)}
        {layer.eyes.map(([x, y, rx, ry, gx, gy, gr], index) => <>
          <g class="eye"><ellipse cx={x} cy={y} rx={rx} ry={ry}/><circle class="glint" cx={x + gx} cy={y + gy} r={gr}/></g>
          {layer.smile > 0 && <path class={index ? "smile" : "smile on-patch"} stroke-width={layer.smile} d={`M${x - rx * 1.05} ${y + ry * .2}C${x - rx * .7} ${y - ry * .55} ${x + rx * .7} ${y - ry * .55} ${x + rx * 1.05} ${y + ry * .2}`}/>}
        </>)}
      </svg>))}</div>
  </div></section>
  <section class="showcase" id="demo" aria-label="Interactive ClipClop preview">
    <div class="showcase-stage">
      <aside class="story" aria-live="polite"><div class="story-track" id="story-track"><div class="story-panel is-current"><h2 set:html={c.storyTitle}/><p>{c.storyCopy}</p></div></div></aside>
    <div class="app-frame"><div class="app-window">
      <header class="titlebar"><div class="menu-wrap"><button class="brand menu-trigger" id="app-menu-trigger" type="button" aria-haspopup="menu" aria-expanded="false"><span class="brand-mark" aria-hidden="true"></span><span>ClipClop</span></button><div class="demo-menu app-menu" id="app-menu" role="menu" hidden><button type="button" role="menuitem"><span>{c.demo.words.settings}</span><kbd aria-hidden="true">⌘,</kbd></button><button type="button" role="menuitem"><span>{c.demo.words.updates}</span></button><button type="button" role="menuitem"><span>{c.demo.words.about}</span></button><hr class="menu-separator"><button type="button" role="menuitem" class="danger"><span>{c.demo.words.quit}</span><kbd aria-hidden="true">⌘Q</kbd></button></div></div></header>
      <section class="left" aria-label="Clipboard history"><div class="search"><Icon name="lucide:search" size={15} stroke-width="1.8" aria-hidden="true"/><input id="search" type="search" placeholder={c.search} autocomplete="off" aria-label={c.search}><button class="filter-static" type="button" aria-label={c.filter}><Icon name="lucide:sliders-horizontal" size={14} aria-hidden="true"/><kbd aria-hidden="true">/</kbd></button></div><div class="scope-switch" role="group" aria-label={c.demo.words.scope}><button type="button" data-scope="all" aria-pressed="true">{c.demo.words.all}</button><button type="button" data-scope="favorites" aria-pressed="false">{c.demo.words.favorites}</button></div><div class="clip-list" id="clip-list" role="listbox" tabindex="0" aria-label="Clipboard history"></div></section>
      <section class="preview" aria-label="Selected clipboard item preview" aria-live="polite"><div class="preview-body"><div class="preview-content" id="preview"></div></div><div class="path-slot" id="path-slot"></div><div class="preview-meta"><div class="meta-content" id="facts"></div></div></section>
      <footer class="pager"><button disabled aria-label="Previous page"><Icon name="lucide:arrow-left" size={16} aria-hidden="true"/></button><div class="page-scrubber" aria-hidden="true"><span class="page-ticks"><i></i><i></i><i></i><i></i><i></i></span></div><span class="page-count">1/1</span><button disabled aria-label="Next page"><Icon name="lucide:arrow-right" size={16} aria-hidden="true"/></button></footer>
      <footer class="actions" aria-label="Preview-only actions"><div class="menu-wrap action-wrap"><button class="static-action menu-trigger" id="action-menu-trigger" type="button" aria-haspopup="menu" aria-expanded="false"><kbd>⌘ K</kbd> <span>{c.actions}</span></button><div class="demo-menu action-menu" id="action-menu" role="menu" hidden><button type="button" role="menuitem" data-action="preview"><span>{c.demo.words.viewSelected}</span><kbd>Space</kbd></button><button type="button" role="menuitem" data-action="link"><span>{c.demo.words.openLink}</span></button><hr class="menu-separator" data-action="preview-separator"><button type="button" role="menuitem" data-action="plain"><span>{c.demo.words.pastePlain}</span><kbd>⇧↵</kbd></button><button type="button" role="menuitem" ><span>{c.demo.words.copy}</span></button><button type="button" role="menuitem" data-action="plain"><span>{c.demo.words.copyPlain}</span><kbd>⇧⌘C</kbd></button><hr class="menu-separator"><button type="button" role="menuitem" data-action="favorite"><span>{c.demo.words.favorite}</span></button><button type="button" role="menuitem" class="danger"><span>{c.demo.words.delete}</span><kbd>⌘⌫</kbd></button></div></div><span class="static-action primary-static" aria-disabled="true">↵ <span>{c.paste}</span></span></footer>
    </div></div>
    </div><div id="steps" aria-hidden="true"></div>
  </section>
  <section class="home-section summon" aria-labelledby="summon-title"><h2 id="summon-title">{c.summon.title}</h2><p>{c.summon.copy}</p>
    <div class="summon-stage" id="summon-stage" aria-hidden="true">
      <div class="editor"><div class="editor-bar" id="editor-name"></div><pre class="editor-body" id="editor-body"></pre></div>
      <div class="summon-window" id="summon-window"><div class="left"><div class="search"><Icon name="lucide:search" size={15} stroke-width="1.8"/><span>{c.search}</span></div><div class="clip-list" id="summon-list"></div></div><div class="preview-body"><pre class="preview-text" id="summon-preview"></pre></div></div>
    </div>
    <div class="summon-keys" id="summon-keys" aria-hidden="true"><kbd data-key="open" class="open-shortcut">⌃⌘C</kbd><kbd data-key="down">↓</kbd><kbd data-key="enter">↵</kbd></div>
  </section>
  <section class="home-section trust" aria-labelledby="trust-title"><h2 id="trust-title">{c.trustTitle}</h2><p>{c.trustCopy}</p><dl class="trust-facts">{c.trustFacts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><nav class="text-links" aria-label="Trust details"><a href="https://github.com/hiQianFan/ClipClop" target="_blank" rel="noopener noreferrer" >{c.source}</a><a href={`/${locale}/privacy`}>{c.privacy}</a></nav></section>
  <section class="home-section faq" aria-labelledby="faq-title"><h2 id="faq-title">{c.faqTitle}</h2><div class="faq-list">{c.faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
  <section class="home-section closing" aria-labelledby="closing-title"><h2 id="closing-title">{c.closingTitle}</h2><p>{c.closingCopy}</p><div class="closing-actions"><a class="primary" href={`/${locale}/download`}><Icon name="lucide:download" size={18} aria-hidden="true"/><span>{c.download}</span></a></div><small class="closing-note"><span id="release-context">{c.release}</span> <a href={`/${locale}/changelog`}>{c.fullChangelog}</a></small></section>
</main>
  <script id="demo-data" type="application/json" set:html={JSON.stringify({ locale, clips: c.demo.clips, words: c.demo.words, scenes: c.summon.scenes })}/>
  <script src="./home.ts"></script>
  <style is:global>@media (min-width: 769px) { #steps { margin-top: -30vh; } }</style>
</LocalizedLayout>
